   ;	
   ;	void InitRedShifts (void)
   ;	
	assume	cs:_TEXT
_InitRedShifts	proc	near
	push	bp
	mov	bp,sp
	sub	sp,8
	push	si
	push	di
   ;	
   ;	{
   ;		byte	far *workptr, far *baseptr;
   ;		int		i,j,delta;
   ;	
   ;	
   ;	//
   ;	// fade through intermediate frames
   ;	//
