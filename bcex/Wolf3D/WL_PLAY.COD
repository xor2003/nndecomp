   ;	
   ;	void PlayLoop (void)
   ;	
	assume	cs:_TEXT
_PlayLoop	proc	near
	push	bp
	mov	bp,sp
	push	si
   ;	
   ;	{
   ;		int		give;
   ;		int	helmetangle;
   ;	
   ;		playstate = TimeCount = lasttimecount = 0;
   ;	
	xor	ax,ax
	xor	dx,dx
	mov	word ptr DGROUP:_lasttimecount,dx
	mov	word ptr DGROUP:_lasttimecount+2,ax
	mov	word ptr DGROUP:_TimeCount,dx
	mov	word ptr DGROUP:_TimeCount+2,ax
	mov	word ptr DGROUP:_playstate,dx
   ;	
   ;		frameon = 0;
   ;	
	mov	word ptr DGROUP:_frameon,0
	mov	word ptr DGROUP:_frameon+2,0
   ;	
   ;		running = false;
   ;	
	mov	word ptr DGROUP:_running,0
   ;	
   ;		anglefrac = 0;
   ;	
	mov	word ptr DGROUP:_anglefrac,0
   ;	
   ;		facecount = 0;
   ;	
	mov	word ptr DGROUP:_facecount,0
   ;	
   ;		funnyticount = 0;
   ;	
	mov	word ptr DGROUP:_funnyticount,0
	mov	word ptr DGROUP:_funnyticount+2,0
   ;	
   ;		memset (buttonstate,0,sizeof(buttonstate));
   ;	
	mov	ax,18
	push	ax
	xor	ax,ax
	push	ax
	mov	ax,offset DGROUP:_buttonstate
	push	ax
	call	near ptr _memset
	add	sp,6
   ;	
   ;		ClearPaletteShifts ();
   ;	
	call	near ptr _ClearPaletteShifts
   ;	
   ;	
   ;		if (MousePresent)
   ;	
	cmp	word ptr DGROUP:_MousePresent,0
	je	short @22@74
   ;	
   ;			Mouse(MDelta);	// Clear accumulated mouse movement
   ;	
	mov	ax,11
	int	51
@22@74:
   ;	
   ;	
   ;		if (demoplayback)
   ;	
	cmp	word ptr DGROUP:_demoplayback,0
	je	short @22@122
   ;	
   ;			IN_StartAck ();
   ;	
	call	near ptr _IN_StartAck
@22@122:
   ;	
   ;	
   ;		do
   ;		{
   ;			if (virtualreality)
   ;	
	cmp	word ptr DGROUP:_virtualreality,0
	je	short @22@194
   ;	
   ;			{
   ;				helmetangle = peek (0x40,0xf0);
   ;	
	mov	ax,64
	mov	es,ax
	mov	si,word ptr es:[240]
   ;	
   ;				player->angle += helmetangle;
   ;	
	mov	bx,word ptr DGROUP:_player
	add	word ptr [bx+40],si
   ;	
   ;				if (player->angle >= ANGLES)
   ;	
	mov	bx,word ptr DGROUP:_player
	cmp	word ptr [bx+40],360
	jl	short @22@194
   ;	
   ;					player->angle -= ANGLES;
   ;	
	mov	bx,word ptr DGROUP:_player
	sub	word ptr [bx+40],360
@22@194:
   ;	
   ;			}
   ;	
   ;	
   ;			PollControls();
   ;	
	call	near ptr _PollControls
   ;	
   ;	
   ;	//
   ;	// actor thinking
   ;	//
   ;			madenoise = false;
   ;	
	mov	word ptr DGROUP:_madenoise,0
   ;	
   ;	
   ;			MoveDoors ();
   ;	
	call	near ptr _MoveDoors
   ;	
   ;			MovePWalls ();
   ;	
	call	near ptr _MovePWalls
   ;	
   ;	
   ;			for (obj = player;obj;obj = obj->next)
   ;	
	mov	ax,word ptr DGROUP:_player
	mov	word ptr DGROUP:_obj,ax
	jmp	short @22@266
@22@218:
   ;	
   ;				DoActor (obj);
   ;	
	push	word ptr DGROUP:_obj
	call	near ptr _DoActor
	pop	cx
	mov	bx,word ptr DGROUP:_obj
	mov	ax,word ptr [bx+54]
	mov	word ptr DGROUP:_obj,ax
@22@266:
	cmp	word ptr DGROUP:_obj,0
	jne	short @22@218
   ;	
   ;	
   ;			UpdatePaletteShifts ();
   ;	
	call	near ptr _UpdatePaletteShifts
   ;	
   ;	
   ;			ThreeDRefresh ();
   ;	
	call	near ptr _ThreeDRefresh
   ;	
   ;	
   ;			//
   ;			// MAKE FUNNY FACE IF BJ DOESN'T MOVE FOR AWHILE
   ;			//
   ;			#ifdef SPEAR
   ;			funnyticount += tics;
   ;			if (funnyticount > 30l*70)
   ;			{
   ;				funnyticount = 0;
   ;				StatusDrawPic (17,4,BJWAITING1PIC+(US_RndT()&1));
   ;				facecount = 0;
   ;			}
   ;			#endif
   ;	
   ;			gamestate.TimeCount+=tics;
   ;	
	mov	ax,word ptr DGROUP:_tics
	add	word ptr DGROUP:_gamestate+52,ax
	adc	word ptr DGROUP:_gamestate+54,0
   ;	
   ;	
   ;			SD_Poll ();
   ;	
	call	near ptr _SD_Poll
   ;	
   ;			UpdateSoundLoc();	// JAB
   ;	
	call	near ptr _UpdateSoundLoc
   ;	
   ;	
   ;			if (screenfaded)
   ;	
	cmp	word ptr DGROUP:_screenfaded,0
	je	short @22@338
   ;	
   ;				VW_FadeIn ();
   ;	
	mov	ax,30
	push	ax
	mov	ax,seg _gamepal
	push	ax
	mov	ax,offset _gamepal
	push	ax
	mov	ax,255
	push	ax
	xor	ax,ax
	push	ax
	call	near ptr _VL_FadeIn
	add	sp,10
@22@338:
   ;	
   ;	
   ;			CheckKeys();
   ;	
	call	near ptr _CheckKeys
   ;	
   ;	
   ;	//
   ;	// debug aids
   ;	//
   ;			if (singlestep)
   ;	
	cmp	word ptr DGROUP:_singlestep,0
	je	short @22@386
   ;	
   ;			{
   ;				VW_WaitVBL(14);
   ;	
	mov	ax,14
	push	ax
	call	near ptr _VL_WaitVBL
	pop	cx
   ;	
   ;				lasttimecount = TimeCount;
   ;	
	mov	ax,word ptr DGROUP:_TimeCount+2
	mov	dx,word ptr DGROUP:_TimeCount
	mov	word ptr DGROUP:_lasttimecount,dx
	mov	word ptr DGROUP:_lasttimecount+2,ax
@22@386:
   ;	
   ;			}
   ;			if (extravbls)
   ;	
	cmp	word ptr DGROUP:_extravbls,0
	je	short @22@434
   ;	
   ;				VW_WaitVBL(extravbls);
   ;	
	push	word ptr DGROUP:_extravbls
	call	near ptr _VL_WaitVBL
	pop	cx
@22@434:
   ;	
   ;	
   ;			if (demoplayback)
   ;	
	cmp	word ptr DGROUP:_demoplayback,0
	je	short @22@506
   ;	
   ;			{
   ;				if (IN_CheckAck ())
   ;	
	call	near ptr _IN_CheckAck
	or	ax,ax
	je	short @22@506
   ;	
   ;				{
   ;					IN_ClearKeysDown ();
   ;	
	call	near ptr _IN_ClearKeysDown
   ;	
   ;					playstate = ex_abort;
   ;	
	mov	word ptr DGROUP:_playstate,7
@22@506:
   ;	
   ;				}
   ;			}
   ;	
   ;	
   ;			if (virtualreality)
   ;	
	cmp	word ptr DGROUP:_virtualreality,0
	je	short @22@578
   ;	
   ;			{
   ;				player->angle -= helmetangle;
   ;	
	mov	bx,word ptr DGROUP:_player
	sub	word ptr [bx+40],si
   ;	
   ;				if (player->angle < 0)
   ;	
	mov	bx,word ptr DGROUP:_player
	cmp	word ptr [bx+40],0
	jge	short @22@578
   ;	
   ;					player->angle += ANGLES;
   ;	
	mov	bx,word ptr DGROUP:_player
	add	word ptr [bx+40],360
@22@578:
   ;	
   ;			}
   ;	
   ;		}while (!playstate && !startgame);
   ;	
	cmp	word ptr DGROUP:_playstate,0
	jne	short @22@626
	cmp	word ptr DGROUP:_startgame,0
	jne	@@13
	jmp	@22@122
@@13:
@22@626:
   ;	
   ;	
   ;		if (playstate != ex_died)
   ;	
	cmp	word ptr DGROUP:_playstate,2
	je	short @22@674
   ;	
   ;			FinishPaletteShifts ();
   ;	
	call	near ptr _FinishPaletteShifts
@22@674:
   ;	
   ;	}
   ;	
	pop	si
	pop	bp
	ret	
_PlayLoop	endp
