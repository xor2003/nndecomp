   ;	
   ;	void PollKeyboardButtons (void)
   ;	
	assume	cs:_TEXT
_PollKeyboardButtons	proc	near
	push	bp
	mov	bp,sp
	push	si
   ;	
   ;	{
   ;		int		i;
   ;	
   ;		for (i=0;i<NUMBUTTONS;i++)
   ;	
	xor	si,si
	jmp	short @1@122
@1@50:
   ;	
   ;			if (Keyboard[buttonscan[i]])
   ;	
	mov	bx,si
	shl	bx,1
	mov	bx,word ptr DGROUP:_buttonscan[bx]
	shl	bx,1
	cmp	word ptr DGROUP:_Keyboard[bx],0
	je	short @1@98
   ;	
   ;				buttonstate[i] = true;
   ;	
	mov	bx,si
	shl	bx,1
	mov	word ptr DGROUP:_buttonstate[bx],1
@1@98:
	inc	si
@1@122:
	cmp	si,9
	jl	short @1@50
   ;	
   ;	}
   ;	
	pop	si
	pop	bp
	ret	
_PollKeyboardButtons	endp
   ;	
   ;	void PollMouseButtons (void)
   ;	
	assume	cs:_TEXT
_PollMouseButtons	proc	near
	push	bp
	mov	bp,sp
	push	si
   ;	
   ;	{
   ;		int	buttons;
   ;	
   ;		buttons = IN_MouseButtons ();
   ;	
	call	near ptr _IN_MouseButtons
	mov	ah,0
	mov	si,ax
   ;	
   ;	
   ;		if (buttons&1)
   ;	
	test	si,1
	je	short @2@74
   ;	
   ;			buttonstate[buttonmouse[0]] = true;
   ;	
	mov	bx,word ptr DGROUP:_buttonmouse
	shl	bx,1
	mov	word ptr DGROUP:_buttonstate[bx],1
@2@74:
   ;	
   ;		if (buttons&2)
   ;	
	test	si,2
	je	short @2@122
   ;	
   ;			buttonstate[buttonmouse[1]] = true;
   ;	
	mov	bx,word ptr DGROUP:_buttonmouse+2
	shl	bx,1
	mov	word ptr DGROUP:_buttonstate[bx],1
@2@122:
   ;	
   ;		if (buttons&4)
   ;	
	test	si,4
	je	short @2@170
   ;	
   ;			buttonstate[buttonmouse[2]] = true;
   ;	
	mov	bx,word ptr DGROUP:_buttonmouse+4
	shl	bx,1
	mov	word ptr DGROUP:_buttonstate[bx],1
@2@170:
   ;	
   ;	}
   ;	
	pop	si
	pop	bp
	ret	
_PollMouseButtons	endp
   ;	
   ;	void PollJoystickButtons (void)
   ;	
	assume	cs:_TEXT
_PollJoystickButtons	proc	near
	push	bp
	mov	bp,sp
	push	si
   ;	
   ;	{
   ;		int	buttons;
   ;	
   ;		buttons = IN_JoyButtons ();
   ;	
	call	near ptr _IN_JoyButtons
	mov	ah,0
	mov	si,ax
   ;	
   ;	
   ;		if (joystickport && !joypadenabled)
   ;	
	cmp	word ptr DGROUP:_joystickport,0
	je	short @3@194
	cmp	word ptr DGROUP:_joypadenabled,0
	jne	short @3@194
   ;	
   ;		{
   ;			if (buttons&4)
   ;	
	test	si,4
	je	short @3@122
   ;	
   ;				buttonstate[buttonjoy[0]] = true;
   ;	
	mov	bx,word ptr DGROUP:_buttonjoy
	shl	bx,1
	mov	word ptr DGROUP:_buttonstate[bx],1
@3@122:
   ;	
   ;			if (buttons&8)
   ;	
	test	si,8
	je	short @3@170
   ;	
   ;				buttonstate[buttonjoy[1]] = true;
   ;	
	mov	bx,word ptr DGROUP:_buttonjoy+2
	shl	bx,1
	mov	word ptr DGROUP:_buttonstate[bx],1
@3@170:
   ;	
   ;		}
   ;	
	jmp	short @3@410
@3@194:
   ;	
   ;		else
   ;		{
   ;			if (buttons&1)
   ;	
	test	si,1
	je	short @3@242
   ;	
   ;				buttonstate[buttonjoy[0]] = true;
   ;	
	mov	bx,word ptr DGROUP:_buttonjoy
	shl	bx,1
	mov	word ptr DGROUP:_buttonstate[bx],1
@3@242:
   ;	
   ;			if (buttons&2)
   ;	
	test	si,2
	je	short @3@290
   ;	
   ;				buttonstate[buttonjoy[1]] = true;
   ;	
	mov	bx,word ptr DGROUP:_buttonjoy+2
	shl	bx,1
	mov	word ptr DGROUP:_buttonstate[bx],1
@3@290:
   ;	
   ;			if (joypadenabled)
   ;	
	cmp	word ptr DGROUP:_joypadenabled,0
	je	short @3@410
   ;	
   ;			{
   ;				if (buttons&4)
   ;	
	test	si,4
	je	short @3@362
   ;	
   ;					buttonstate[buttonjoy[2]] = true;
   ;	
	mov	bx,word ptr DGROUP:_buttonjoy+4
	shl	bx,1
	mov	word ptr DGROUP:_buttonstate[bx],1
@3@362:
   ;	
   ;				if (buttons&8)
   ;	
	test	si,8
	je	short @3@410
   ;	
   ;					buttonstate[buttonjoy[3]] = true;
   ;	
	mov	bx,word ptr DGROUP:_buttonjoy+6
	shl	bx,1
	mov	word ptr DGROUP:_buttonstate[bx],1
@3@410:
   ;	
   ;			}
   ;		}
   ;	}
   ;	
	pop	si
	pop	bp
	ret	
_PollJoystickButtons	endp
   ;	
   ;	void PollKeyboardMove (void)
   ;	
	assume	cs:_TEXT
_PollKeyboardMove	proc	near
	push	bp
	mov	bp,sp
   ;	
   ;	{
   ;		if (buttonstate[bt_run])
   ;	
	cmp	word ptr DGROUP:_buttonstate+6,0
	jne	@@0
	jmp	@4@266
@@0:
   ;	
   ;		{
   ;			if (Keyboard[dirscan[di_north]])
   ;	
	mov	bx,word ptr DGROUP:_dirscan
	shl	bx,1
	cmp	word ptr DGROUP:_Keyboard[bx],0
	je	short @4@98
   ;	
   ;				controly -= RUNMOVE*tics;
   ;	
	mov	ax,word ptr DGROUP:_tics
	mov	dx,70
	imul	dx
	mov	dx,word ptr DGROUP:_controly
	sub	dx,ax
	mov	word ptr DGROUP:_controly,dx
@4@98:
   ;	
   ;			if (Keyboard[dirscan[di_south]])
   ;	
	mov	bx,word ptr DGROUP:_dirscan+4
	shl	bx,1
	cmp	word ptr DGROUP:_Keyboard[bx],0
	je	short @4@146
   ;	
   ;				controly += RUNMOVE*tics;
   ;	
	mov	ax,word ptr DGROUP:_tics
	mov	dx,70
	imul	dx
	mov	dx,word ptr DGROUP:_controly
	add	dx,ax
	mov	word ptr DGROUP:_controly,dx
@4@146:
   ;	
   ;			if (Keyboard[dirscan[di_west]])
   ;	
	mov	bx,word ptr DGROUP:_dirscan+6
	shl	bx,1
	cmp	word ptr DGROUP:_Keyboard[bx],0
	je	short @4@194
   ;	
   ;				controlx -= RUNMOVE*tics;
   ;	
	mov	ax,word ptr DGROUP:_tics
	mov	dx,70
	imul	dx
	mov	dx,word ptr DGROUP:_controlx
	sub	dx,ax
	mov	word ptr DGROUP:_controlx,dx
@4@194:
   ;	
   ;			if (Keyboard[dirscan[di_east]])
   ;	
	mov	bx,word ptr DGROUP:_dirscan+2
	shl	bx,1
	cmp	word ptr DGROUP:_Keyboard[bx],0
	je	short @4@242
   ;	
   ;				controlx += RUNMOVE*tics;
   ;	
	mov	ax,word ptr DGROUP:_tics
	mov	dx,70
	imul	dx
	mov	dx,word ptr DGROUP:_controlx
	add	dx,ax
	mov	word ptr DGROUP:_controlx,dx
@4@242:
   ;	
   ;		}
   ;	
	jmp	@4@458
@4@266:
   ;	
   ;		else
   ;		{
   ;			if (Keyboard[dirscan[di_north]])
   ;	
	mov	bx,word ptr DGROUP:_dirscan
	shl	bx,1
	cmp	word ptr DGROUP:_Keyboard[bx],0
	je	short @4@314
   ;	
   ;				controly -= BASEMOVE*tics;
   ;	
	mov	ax,word ptr DGROUP:_tics
	mov	dx,35
	imul	dx
	mov	dx,word ptr DGROUP:_controly
	sub	dx,ax
	mov	word ptr DGROUP:_controly,dx
@4@314:
   ;	
   ;			if (Keyboard[dirscan[di_south]])
   ;	
	mov	bx,word ptr DGROUP:_dirscan+4
	shl	bx,1
	cmp	word ptr DGROUP:_Keyboard[bx],0
	je	short @4@362
   ;	
   ;				controly += BASEMOVE*tics;
   ;	
	mov	ax,word ptr DGROUP:_tics
	mov	dx,35
	imul	dx
	mov	dx,word ptr DGROUP:_controly
	add	dx,ax
	mov	word ptr DGROUP:_controly,dx
@4@362:
   ;	
   ;			if (Keyboard[dirscan[di_west]])
   ;	
	mov	bx,word ptr DGROUP:_dirscan+6
	shl	bx,1
	cmp	word ptr DGROUP:_Keyboard[bx],0
	je	short @4@410
   ;	
   ;				controlx -= BASEMOVE*tics;
   ;	
	mov	ax,word ptr DGROUP:_tics
	mov	dx,35
	imul	dx
	mov	dx,word ptr DGROUP:_controlx
	sub	dx,ax
	mov	word ptr DGROUP:_controlx,dx
@4@410:
   ;	
   ;			if (Keyboard[dirscan[di_east]])
   ;	
	mov	bx,word ptr DGROUP:_dirscan+2
	shl	bx,1
	cmp	word ptr DGROUP:_Keyboard[bx],0
	je	short @4@458
   ;	
   ;				controlx += BASEMOVE*tics;
   ;	
	mov	ax,word ptr DGROUP:_tics
	mov	dx,35
	imul	dx
	mov	dx,word ptr DGROUP:_controlx
	add	dx,ax
	mov	word ptr DGROUP:_controlx,dx
@4@458:
   ;	
   ;		}
   ;	}
   ;	
	pop	bp
	ret	
_PollKeyboardMove	endp
   ;	
   ;	void PollMouseMove (void)
   ;	
	assume	cs:_TEXT
_PollMouseMove	proc	near
	push	bp
	mov	bp,sp
	push	si
   ;	
   ;	{
   ;		int	mousexmove,mouseymove;
   ;	
   ;		Mouse(MDelta);
   ;	
	mov	ax,11
	int	51
   ;	
   ;		mousexmove = _CX;
   ;	
	mov	si,cx
   ;	
   ;		//mouseymove = _DX;
   ;	
   ;		controlx += mousexmove*10/(13-mouseadjustment);
   ;	
	mov	ax,si
	mov	dx,10
	imul	dx
	mov	bx,13
	sub	bx,word ptr DGROUP:_mouseadjustment
	cwd	
	idiv	bx
	add	word ptr DGROUP:_controlx,ax
   ;	
   ;		//controly += mouseymove*20/(13-mouseadjustment);
   ;	}
   ;	
	pop	si
	pop	bp
	ret	
_PollMouseMove	endp
   ;	
   ;	void PollJoystickMove (void)
   ;	
	assume	cs:_TEXT
_PollJoystickMove	proc	near
	push	bp
	mov	bp,sp
	sub	sp,4
   ;	
   ;	{
   ;		int	joyx,joyy;
   ;	
   ;		INL_GetJoyDelta(joystickport,&joyx,&joyy);
   ;	
	lea	ax,word ptr [bp-4]
	push	ax
	lea	ax,word ptr [bp-2]
	push	ax
	push	word ptr DGROUP:_joystickport
	call	near ptr _INL_GetJoyDelta
	add	sp,6
   ;	
   ;	
   ;		if (joystickprogressive)
   ;	
	cmp	word ptr DGROUP:_joystickprogressive,0
	jne	@@1
	jmp	@6@266
@@1:
   ;	
   ;		{
   ;			if (joyx > 64)
   ;	
	cmp	word ptr [bp-2],64
	jle	short @6@98
   ;	
   ;				controlx += (joyx-64)*JOYSCALE*tics;
   ;	
	mov	ax,word ptr [bp-2]
	add	ax,65472
	shl	ax,1
	imul	word ptr DGROUP:_tics
	mov	dx,word ptr DGROUP:_controlx
	add	dx,ax
	mov	word ptr DGROUP:_controlx,dx
	jmp	short @6@146
@6@98:
   ;	
   ;			else if (joyx < -64)
   ;	
	cmp	word ptr [bp-2],65472
	jge	short @6@146
   ;	
   ;				controlx -= (-joyx-64)*JOYSCALE*tics;
   ;	
	mov	ax,word ptr [bp-2]
	neg	ax
	add	ax,65472
	shl	ax,1
	imul	word ptr DGROUP:_tics
	mov	dx,word ptr DGROUP:_controlx
	sub	dx,ax
	mov	word ptr DGROUP:_controlx,dx
@6@146:
   ;	
   ;			if (joyy > 64)
   ;	
	cmp	word ptr [bp-4],64
	jle	short @6@194
   ;	
   ;				controlx += (joyy-64)*JOYSCALE*tics;
   ;	
	mov	ax,word ptr [bp-4]
	add	ax,65472
	shl	ax,1
	imul	word ptr DGROUP:_tics
	mov	dx,word ptr DGROUP:_controlx
	add	dx,ax
	mov	word ptr DGROUP:_controlx,dx
	jmp	short @6@242
@6@194:
   ;	
   ;			else if (joyy < -64)
   ;	
	cmp	word ptr [bp-4],65472
	jge	short @6@242
   ;	
   ;				controly -= (-joyy-64)*JOYSCALE*tics;
   ;	
	mov	ax,word ptr [bp-4]
	neg	ax
	add	ax,65472
	shl	ax,1
	imul	word ptr DGROUP:_tics
	mov	dx,word ptr DGROUP:_controly
	sub	dx,ax
	mov	word ptr DGROUP:_controly,dx
@6@242:
   ;	
   ;		}
   ;	
	jmp	@6@698
@6@266:
   ;	
   ;		else if (buttonstate[bt_run])
   ;	
	cmp	word ptr DGROUP:_buttonstate+6,0
	je	short @6@506
   ;	
   ;		{
   ;			if (joyx > 64)
   ;	
	cmp	word ptr [bp-2],64
	jle	short @6@338
   ;	
   ;				controlx += RUNMOVE*tics;
   ;	
	mov	ax,word ptr DGROUP:_tics
	mov	dx,70
	imul	dx
	mov	dx,word ptr DGROUP:_controlx
	add	dx,ax
	mov	word ptr DGROUP:_controlx,dx
	jmp	short @6@386
@6@338:
   ;	
   ;			else if (joyx < -64)
   ;	
	cmp	word ptr [bp-2],65472
	jge	short @6@386
   ;	
   ;				controlx -= RUNMOVE*tics;
   ;	
	mov	ax,word ptr DGROUP:_tics
	mov	dx,70
	imul	dx
	mov	dx,word ptr DGROUP:_controlx
	sub	dx,ax
	mov	word ptr DGROUP:_controlx,dx
@6@386:
   ;	
   ;			if (joyy > 64)
   ;	
	cmp	word ptr [bp-4],64
	jle	short @6@434
   ;	
   ;				controly += RUNMOVE*tics;
   ;	
	mov	ax,word ptr DGROUP:_tics
	mov	dx,70
	imul	dx
	mov	dx,word ptr DGROUP:_controly
	add	dx,ax
	mov	word ptr DGROUP:_controly,dx
	jmp	short @6@482
@6@434:
   ;	
   ;			else if (joyy < -64)
   ;	
	cmp	word ptr [bp-4],65472
	jge	short @6@482
   ;	
   ;				controly -= RUNMOVE*tics;
   ;	
	mov	ax,word ptr DGROUP:_tics
	mov	dx,70
	imul	dx
	mov	dx,word ptr DGROUP:_controly
	sub	dx,ax
	mov	word ptr DGROUP:_controly,dx
@6@482:
   ;	
   ;		}
   ;	
	jmp	short @6@698
@6@506:
   ;	
   ;		else
   ;		{
   ;			if (joyx > 64)
   ;	
	cmp	word ptr [bp-2],64
	jle	short @6@554
   ;	
   ;				controlx += BASEMOVE*tics;
   ;	
	mov	ax,word ptr DGROUP:_tics
	mov	dx,35
	imul	dx
	mov	dx,word ptr DGROUP:_controlx
	add	dx,ax
	mov	word ptr DGROUP:_controlx,dx
	jmp	short @6@602
@6@554:
   ;	
   ;			else if (joyx < -64)
   ;	
	cmp	word ptr [bp-2],65472
	jge	short @6@602
   ;	
   ;				controlx -= BASEMOVE*tics;
   ;	
	mov	ax,word ptr DGROUP:_tics
	mov	dx,35
	imul	dx
	mov	dx,word ptr DGROUP:_controlx
	sub	dx,ax
	mov	word ptr DGROUP:_controlx,dx
@6@602:
   ;	
   ;			if (joyy > 64)
   ;	
	cmp	word ptr [bp-4],64
	jle	short @6@650
   ;	
   ;				controly += BASEMOVE*tics;
   ;	
	mov	ax,word ptr DGROUP:_tics
	mov	dx,35
	imul	dx
	mov	dx,word ptr DGROUP:_controly
	add	dx,ax
	mov	word ptr DGROUP:_controly,dx
	jmp	short @6@698
@6@650:
   ;	
   ;			else if (joyy < -64)
   ;	
	cmp	word ptr [bp-4],65472
	jge	short @6@698
   ;	
   ;				controly -= BASEMOVE*tics;
   ;	
	mov	ax,word ptr DGROUP:_tics
	mov	dx,35
	imul	dx
	mov	dx,word ptr DGROUP:_controly
	sub	dx,ax
	mov	word ptr DGROUP:_controly,dx
@6@698:
   ;	
   ;		}
   ;	}
   ;	
	mov	sp,bp
	pop	bp
	ret	
_PollJoystickMove	endp
   ;	
   ;	void PollControls (void)
   ;	
	assume	cs:_TEXT
_PollControls	proc	near
	push	bp
	mov	bp,sp
	sub	sp,4
	push	si
	push	di
   ;	
   ;	{
   ;		int		max,min,i;
   ;		byte	buttonbits;
   ;	
   ;	//
   ;	// get timing info for last frame
   ;	//
   ;		if (demoplayback)
   ;	
	cmp	word ptr DGROUP:_demoplayback,0
	je	short @7@170
	jmp	short @7@74
@7@74:
   ;	
   ;		{
   ;			while (TimeCount<lasttimecount+DEMOTICS)
   ;	
	mov	ax,word ptr DGROUP:_lasttimecount+2
	mov	dx,word ptr DGROUP:_lasttimecount
	add	dx,4
	adc	ax,0
	cmp	ax,word ptr DGROUP:_TimeCount+2
	ja	short @7@74
	jne	short @7@146
	cmp	dx,word ptr DGROUP:_TimeCount
	ja	short @7@74
@7@146:
   ;	
   ;			;
   ;			TimeCount = lasttimecount + DEMOTICS;
   ;	
	mov	ax,word ptr DGROUP:_lasttimecount+2
	mov	dx,word ptr DGROUP:_lasttimecount
	add	dx,4
	adc	ax,0
	mov	word ptr DGROUP:_TimeCount,dx
	mov	word ptr DGROUP:_TimeCount+2,ax
   ;	
   ;			lasttimecount += DEMOTICS;
   ;	
	add	word ptr DGROUP:_lasttimecount,4
	adc	word ptr DGROUP:_lasttimecount+2,0
   ;	
   ;			tics = DEMOTICS;
   ;	
	mov	word ptr DGROUP:_tics,4
   ;	
   ;		}
   ;	
	jmp	short @7@338
@7@170:
   ;	
   ;		else if (demorecord)			// demo recording and playback needs
   ;	
	cmp	word ptr DGROUP:_demorecord,0
	je	short @7@314
	jmp	short @7@218
@7@218:
   ;	
   ;		{								// to be constant
   ;	//
   ;	// take DEMOTICS or more tics, and modify Timecount to reflect time taken
   ;	//
   ;			while (TimeCount<lasttimecount+DEMOTICS)
   ;	
	mov	ax,word ptr DGROUP:_lasttimecount+2
	mov	dx,word ptr DGROUP:_lasttimecount
	add	dx,4
	adc	ax,0
	cmp	ax,word ptr DGROUP:_TimeCount+2
	ja	short @7@218
	jne	short @7@290
	cmp	dx,word ptr DGROUP:_TimeCount
	ja	short @7@218
@7@290:
   ;	
   ;			;
   ;			TimeCount = lasttimecount + DEMOTICS;
   ;	
	mov	ax,word ptr DGROUP:_lasttimecount+2
	mov	dx,word ptr DGROUP:_lasttimecount
	add	dx,4
	adc	ax,0
	mov	word ptr DGROUP:_TimeCount,dx
	mov	word ptr DGROUP:_TimeCount+2,ax
   ;	
   ;			lasttimecount += DEMOTICS;
   ;	
	add	word ptr DGROUP:_lasttimecount,4
	adc	word ptr DGROUP:_lasttimecount+2,0
   ;	
   ;			tics = DEMOTICS;
   ;	
	mov	word ptr DGROUP:_tics,4
   ;	
   ;		}
   ;	
	jmp	short @7@338
@7@314:
   ;	
   ;		else
   ;			CalcTics ();
   ;	
	call	near ptr _CalcTics
@7@338:
   ;	
   ;	
   ;		controlx = 0;
   ;	
	mov	word ptr DGROUP:_controlx,0
   ;	
   ;		controly = 0;
   ;	
	mov	word ptr DGROUP:_controly,0
   ;	
   ;		memcpy (buttonheld,buttonstate,sizeof(buttonstate));
   ;	
	mov	ax,18
	push	ax
	mov	ax,offset DGROUP:_buttonstate
	push	ax
	mov	ax,offset DGROUP:_buttonheld
	push	ax
	call	near ptr _memcpy
	add	sp,6
   ;	
   ;		memset (buttonstate,0,sizeof(buttonstate));
   ;	
	mov	ax,18
	push	ax
	xor	ax,ax
	push	ax
	mov	ax,offset DGROUP:_buttonstate
	push	ax
	call	near ptr _memset
	add	sp,6
   ;	
   ;	
   ;		if (demoplayback)
   ;	
	cmp	word ptr DGROUP:_demoplayback,0
	jne	@@2
	jmp	@7@554
@@2:
   ;	
   ;		{
   ;		//
   ;		// read commands from demo buffer
   ;		//
   ;			buttonbits = *demoptr++;
   ;	
	les	bx,dword ptr DGROUP:_demoptr
	mov	al,byte ptr es:[bx]
	mov	byte ptr [bp-3],al
	inc	word ptr DGROUP:_demoptr
   ;	
   ;			for (i=0;i<NUMBUTTONS;i++)
   ;	
	xor	si,si
	jmp	short @7@434
@7@386:
   ;	
   ;			{
   ;				buttonstate[i] = buttonbits&1;
   ;	
	mov	bx,si
	shl	bx,1
	mov	al,byte ptr [bp-3]
	mov	ah,0
	and	ax,1
	mov	word ptr DGROUP:_buttonstate[bx],ax
   ;	
   ;				buttonbits >>= 1;
   ;	
	shr	byte ptr [bp-3],1
	inc	si
@7@434:
	cmp	si,9
	jl	short @7@386
   ;	
   ;			}
   ;	
   ;			controlx = *demoptr++;
   ;	
	les	bx,dword ptr DGROUP:_demoptr
	mov	al,byte ptr es:[bx]
	cbw	
	mov	word ptr DGROUP:_controlx,ax
	inc	word ptr DGROUP:_demoptr
   ;	
   ;			controly = *demoptr++;
   ;	
	les	bx,dword ptr DGROUP:_demoptr
	mov	al,byte ptr es:[bx]
	cbw	
	mov	word ptr DGROUP:_controly,ax
	inc	word ptr DGROUP:_demoptr
   ;	
   ;	
   ;			if (demoptr == lastdemoptr)
   ;	
	mov	ax,word ptr DGROUP:_demoptr+2
	mov	dx,word ptr DGROUP:_demoptr
	cmp	ax,word ptr DGROUP:_lastdemoptr+2
	jne	short @7@530
	cmp	dx,word ptr DGROUP:_lastdemoptr
	jne	short @7@530
   ;	
   ;				playstate = ex_completed;		// demo is done
   ;	
	mov	word ptr DGROUP:_playstate,1
@7@530:
   ;	
   ;	
   ;			controlx *= (int)tics;
   ;	
	mov	ax,word ptr DGROUP:_controlx
	imul	word ptr DGROUP:_tics
	mov	word ptr DGROUP:_controlx,ax
   ;	
   ;			controly *= (int)tics;
   ;	
	mov	ax,word ptr DGROUP:_controly
	imul	word ptr DGROUP:_tics
	mov	word ptr DGROUP:_controly,ax
   ;	
   ;	
   ;			return;
   ;	
	jmp	@7@1154
@7@554:
   ;	
   ;		}
   ;	
   ;	
   ;	//
   ;	// get button states
   ;	//
   ;		PollKeyboardButtons ();
   ;	
	call	near ptr _PollKeyboardButtons
   ;	
   ;	
   ;		if (mouseenabled)
   ;	
	cmp	word ptr DGROUP:_mouseenabled,0
	je	short @7@602
   ;	
   ;			PollMouseButtons ();
   ;	
	call	near ptr _PollMouseButtons
@7@602:
   ;	
   ;	
   ;		if (joystickenabled)
   ;	
	cmp	word ptr DGROUP:_joystickenabled,0
	je	short @7@650
   ;	
   ;			PollJoystickButtons ();
   ;	
	call	near ptr _PollJoystickButtons
@7@650:
   ;	
   ;	
   ;	//
   ;	// get movements
   ;	//
   ;		PollKeyboardMove ();
   ;	
	call	near ptr _PollKeyboardMove
   ;	
   ;	
   ;		if (mouseenabled)
   ;	
	cmp	word ptr DGROUP:_mouseenabled,0
	je	short @7@698
   ;	
   ;			PollMouseMove ();
   ;	
	call	near ptr _PollMouseMove
@7@698:
   ;	
   ;	
   ;		if (joystickenabled)
   ;	
	cmp	word ptr DGROUP:_joystickenabled,0
	je	short @7@746
   ;	
   ;			PollJoystickMove ();
   ;	
	call	near ptr _PollJoystickMove
@7@746:
   ;	
   ;	
   ;	//
   ;	// bound movement to a maximum
   ;	//
   ;		max = 100*tics;
   ;	
	mov	ax,word ptr DGROUP:_tics
	mov	dx,100
	imul	dx
	mov	di,ax
   ;	
   ;		min = -max;
   ;	
	mov	ax,di
	neg	ax
	mov	word ptr [bp-2],ax
   ;	
   ;		if (controlx > max)
   ;	
	cmp	word ptr DGROUP:_controlx,di
	jle	short @7@794
   ;	
   ;			controlx = max;
   ;	
	mov	word ptr DGROUP:_controlx,di
	jmp	short @7@842
@7@794:
   ;	
   ;		else if (controlx < min)
   ;	
	mov	ax,word ptr DGROUP:_controlx
	cmp	ax,word ptr [bp-2]
	jge	short @7@842
   ;	
   ;			controlx = min;
   ;	
	mov	ax,word ptr [bp-2]
	mov	word ptr DGROUP:_controlx,ax
@7@842:
   ;	
   ;	
   ;		if (controly > max)
   ;	
	cmp	word ptr DGROUP:_controly,di
	jle	short @7@890
   ;	
   ;			controly = max;
   ;	
	mov	word ptr DGROUP:_controly,di
	jmp	short @7@938
@7@890:
   ;	
   ;		else if (controly < min)
   ;	
	mov	ax,word ptr DGROUP:_controly
	cmp	ax,word ptr [bp-2]
	jge	short @7@938
   ;	
   ;			controly = min;
   ;	
	mov	ax,word ptr [bp-2]
	mov	word ptr DGROUP:_controly,ax
@7@938:
   ;	
   ;	
   ;		if (demorecord)
   ;	
	cmp	word ptr DGROUP:_demorecord,0
	jne	@@3
	jmp	@7@1154
@@3:
   ;	
   ;		{
   ;		//
   ;		// save info out to demo buffer
   ;		//
   ;			controlx /= (int)tics;
   ;	
	mov	ax,word ptr DGROUP:_controlx
	cwd	
	idiv	word ptr DGROUP:_tics
	mov	word ptr DGROUP:_controlx,ax
   ;	
   ;			controly /= (int)tics;
   ;	
	mov	ax,word ptr DGROUP:_controly
	cwd	
	idiv	word ptr DGROUP:_tics
	mov	word ptr DGROUP:_controly,ax
   ;	
   ;	
   ;			buttonbits = 0;
   ;	
	mov	byte ptr [bp-3],0
   ;	
   ;	
   ;			for (i=NUMBUTTONS-1;i>=0;i--)
   ;	
	mov	si,8
	jmp	short @7@1058
@7@986:
   ;	
   ;			{
   ;				buttonbits <<= 1;
   ;	
	shl	byte ptr [bp-3],1
   ;	
   ;				if (buttonstate[i])
   ;	
	mov	bx,si
	shl	bx,1
	cmp	word ptr DGROUP:_buttonstate[bx],0
	je	short @7@1034
   ;	
   ;					buttonbits |= 1;
   ;	
	mov	al,byte ptr [bp-3]
	or	al,1
	mov	byte ptr [bp-3],al
@7@1034:
	dec	si
@7@1058:
	or	si,si
	jge	short @7@986
   ;	
   ;			}
   ;	
   ;			*demoptr++ = buttonbits;
   ;	
	les	bx,dword ptr DGROUP:_demoptr
	mov	al,byte ptr [bp-3]
	mov	byte ptr es:[bx],al
	inc	word ptr DGROUP:_demoptr
   ;	
   ;			*demoptr++ = controlx;
   ;	
	les	bx,dword ptr DGROUP:_demoptr
	mov	al,byte ptr DGROUP:_controlx
	mov	byte ptr es:[bx],al
	inc	word ptr DGROUP:_demoptr
   ;	
   ;			*demoptr++ = controly;
   ;	
	les	bx,dword ptr DGROUP:_demoptr
	mov	al,byte ptr DGROUP:_controly
	mov	byte ptr es:[bx],al
	inc	word ptr DGROUP:_demoptr
   ;	
   ;	
   ;			if (demoptr >= lastdemoptr)
   ;	
	mov	ax,word ptr DGROUP:_demoptr
	cmp	ax,word ptr DGROUP:_lastdemoptr
	jb	short @7@1130
   ;	
   ;				Quit ("Demo buffer overflowed!");
   ;	
	mov	ax,offset DGROUP:s@
	push	ax
	call	near ptr _Quit
	pop	cx
@7@1130:
   ;	
   ;	
   ;			controlx *= (int)tics;
   ;	
	mov	ax,word ptr DGROUP:_controlx
	imul	word ptr DGROUP:_tics
	mov	word ptr DGROUP:_controlx,ax
   ;	
   ;			controly *= (int)tics;
   ;	
	mov	ax,word ptr DGROUP:_controly
	imul	word ptr DGROUP:_tics
	mov	word ptr DGROUP:_controly,ax
@7@1154:
   ;	
   ;		}
   ;	}
   ;	
	pop	di
	pop	si
	mov	sp,bp
	pop	bp
	ret	
_PollControls	endp
   ;	
   ;	void	CenterWindow(word w,word h)
   ;	
	assume	cs:_TEXT
_CenterWindow	proc	near
	push	bp
	mov	bp,sp
   ;	
   ;	{
   ;		FixOfs ();
   ;	
	call	near ptr _FixOfs
   ;	
   ;		US_DrawWindow(((MAXX / 8) - w) / 2,((MAXY / 8) - h) / 2,w,h);
   ;	
	push	word ptr [bp+6]
	push	word ptr [bp+4]
	mov	ax,20
	sub	ax,word ptr [bp+6]
	shr	ax,1
	push	ax
	mov	ax,40
	sub	ax,word ptr [bp+4]
	shr	ax,1
	push	ax
	call	near ptr _US_DrawWindow
	add	sp,8
   ;	
   ;	}
   ;	
	pop	bp
	ret	
_CenterWindow	endp
   ;	
   ;	void CheckKeys (void)
   ;	
	assume	cs:_TEXT
_CheckKeys	proc	near
	push	bp
	mov	bp,sp
	dec	sp
	dec	sp
   ;	
   ;	{
   ;		int		i;
   ;		byte	scan;
   ;		unsigned	temp;
   ;	
   ;	
   ;		if (screenfaded || demoplayback)	// don't do anything with a faded screen
   ;	
	cmp	word ptr DGROUP:_screenfaded,0
	jne	short @9@74
	cmp	word ptr DGROUP:_demoplayback,0
	je	short @9@98
@9@74:
   ;	
   ;			return;
   ;	
	jmp	@9@1058
@9@98:
   ;	
   ;	
   ;		scan = LastScan;
   ;	
	mov	al,byte ptr DGROUP:_LastScan
	mov	byte ptr [bp-1],al
   ;	
   ;	
   ;	
   ;		#ifdef SPEAR
   ;		//
   ;		// SECRET CHEAT CODE: TAB-G-F10
   ;		//
   ;		if (Keyboard[sc_Tab] &&
   ;			Keyboard[sc_G] &&
   ;			Keyboard[sc_F10])
   ;		{
   ;			WindowH = 160;
   ;			if (godmode)
   ;			{
   ;				Message ("God mode OFF");
   ;				SD_PlaySound (NOBONUSSND);
   ;			}
   ;			else
   ;			{
   ;				Message ("God mode ON");
   ;				SD_PlaySound (ENDBONUS2SND);
   ;			}
   ;	
   ;			IN_Ack();
   ;			godmode ^= 1;
   ;			DrawAllPlayBorderSides ();
   ;			IN_ClearKeysDown();
   ;			return;
   ;		}
   ;		#endif
   ;	
   ;	
   ;		//
   ;		// SECRET CHEAT CODE: 'MLI'
   ;		//
   ;		if (Keyboard[sc_M] &&
   ;	
   ;	
   ;			Keyboard[sc_L] &&
   ;			Keyboard[sc_I])
   ;	
	cmp	word ptr DGROUP:_Keyboard+100,0
	jne	@@4
	jmp	@9@194
@@4:
	cmp	word ptr DGROUP:_Keyboard+76,0
	jne	@@5
	jmp	@9@194
@@5:
	cmp	word ptr DGROUP:_Keyboard+46,0
	jne	@@6
	jmp	@9@194
@@6:
   ;	
   ;		{
   ;			gamestate.health = 100;
   ;	
	mov	word ptr DGROUP:_gamestate+18,100
   ;	
   ;			gamestate.ammo = 99;
   ;	
	mov	word ptr DGROUP:_gamestate+20,99
   ;	
   ;			gamestate.keys = 3;
   ;	
	mov	word ptr DGROUP:_gamestate+22,3
   ;	
   ;			gamestate.score = 0;
   ;	
	mov	word ptr DGROUP:_gamestate+8,0
	mov	word ptr DGROUP:_gamestate+10,0
   ;	
   ;			gamestate.TimeCount += 42000L;
   ;	
	add	word ptr DGROUP:_gamestate+52,42000
	adc	word ptr DGROUP:_gamestate+54,0
   ;	
   ;			GiveWeapon (wp_chaingun);
   ;	
	mov	ax,3
	push	ax
	call	near ptr _GiveWeapon
	pop	cx
   ;	
   ;	
   ;			DrawWeapon();
   ;	
	call	near ptr _DrawWeapon
   ;	
   ;			DrawHealth();
   ;	
	call	near ptr _DrawHealth
   ;	
   ;			DrawKeys();
   ;	
	call	near ptr _DrawKeys
   ;	
   ;			DrawAmmo();
   ;	
	call	near ptr _DrawAmmo
   ;	
   ;			DrawScore();
   ;	
	call	near ptr _DrawScore
   ;	
   ;	
   ;			ClearMemory ();
   ;	
	call	near ptr _ClearMemory
   ;	
   ;			CA_CacheGrChunk (STARTFONT+1);
   ;	
	mov	ax,2
	push	ax
	call	near ptr _CA_CacheGrChunk
	pop	cx
   ;	
   ;			ClearSplitVWB ();
   ;	
	call	near ptr _ClearSplitVWB
   ;	
   ;			VW_ScreenToScreen (displayofs,bufferofs,80,160);
   ;	
	mov	ax,160
	push	ax
	mov	ax,80
	push	ax
	push	word ptr DGROUP:_bufferofs
	push	word ptr DGROUP:_displayofs
	call	near ptr _VL_ScreenToScreen
	add	sp,8
   ;	
   ;	
   ;			Message(STR_CHEATER1"\n"
   ;	
   ;	
   ;					STR_CHEATER2"\n\n"
   ;					STR_CHEATER3"\n"
   ;					STR_CHEATER4"\n"
   ;					STR_CHEATER5);
   ;	
	push	ds
	mov	ax,offset DGROUP:s@+24
	push	ax
	call	near ptr _Message
	pop	cx
	pop	cx
   ;	
   ;	
   ;			UNCACHEGRCHUNK(STARTFONT+1);
   ;	
	mov	ax,offset DGROUP:_grsegs+4
	push	ax
	call	near ptr _MM_FreePtr
	pop	cx
	mov	ax,seg _grneeded
	mov	es,ax
	mov	al,byte ptr es:_grneeded+2
	mov	dl,byte ptr DGROUP:_ca_levelbit
	not	dl
	and	al,dl
	mov	dx,seg _grneeded
	mov	es,dx
	mov	byte ptr es:_grneeded+2,al
   ;	
   ;			PM_CheckMainMem ();
   ;	
	call	near ptr _PM_CheckMainMem
   ;	
   ;			IN_ClearKeysDown();
   ;	
	call	near ptr _IN_ClearKeysDown
   ;	
   ;			IN_Ack();
   ;	
	call	near ptr _IN_Ack
   ;	
   ;	
   ;			DrawAllPlayBorder ();
   ;	
	call	near ptr _DrawAllPlayBorder
@9@194:
   ;	
   ;		}
   ;	
   ;		//
   ;		// OPEN UP DEBUG KEYS
   ;		//
   ;	#ifndef SPEAR
   ;		if (Keyboard[sc_BackSpace] &&
   ;	
   ;	
   ;			Keyboard[sc_LShift] &&
   ;			Keyboard[sc_Alt] &&
   ;			MS_CheckParm("goobers"))
   ;	
	cmp	word ptr DGROUP:_Keyboard+28,0
	jne	@@7
	jmp	@9@314
@@7:
	cmp	word ptr DGROUP:_Keyboard+84,0
	je	short @9@314
	cmp	word ptr DGROUP:_Keyboard+112,0
	je	short @9@314
	push	ds
	mov	ax,offset DGROUP:s@+152
	push	ax
	call	near ptr _MS_CheckParm
	pop	cx
	pop	cx
	or	ax,ax
	je	short @9@314
   ;	
   ;	#else
   ;		if (Keyboard[sc_BackSpace] &&
   ;			Keyboard[sc_LShift] &&
   ;			Keyboard[sc_Alt] &&
   ;			MS_CheckParm("debugmode"))
   ;	#endif
   ;		{
   ;		 ClearMemory ();
   ;	
	call	near ptr _ClearMemory
   ;	
   ;		 CA_CacheGrChunk (STARTFONT+1);
   ;	
	mov	ax,2
	push	ax
	call	near ptr _CA_CacheGrChunk
	pop	cx
   ;	
   ;		 ClearSplitVWB ();
   ;	
	call	near ptr _ClearSplitVWB
   ;	
   ;		 VW_ScreenToScreen (displayofs,bufferofs,80,160);
   ;	
	mov	ax,160
	push	ax
	mov	ax,80
	push	ax
	push	word ptr DGROUP:_bufferofs
	push	word ptr DGROUP:_displayofs
	call	near ptr _VL_ScreenToScreen
	add	sp,8
   ;	
   ;	
   ;		 Message("Debugging keys are\nnow available!");
   ;	
	push	ds
	mov	ax,offset DGROUP:s@+160
	push	ax
	call	near ptr _Message
	pop	cx
	pop	cx
   ;	
   ;		 UNCACHEGRCHUNK(STARTFONT+1);
   ;	
	mov	ax,offset DGROUP:_grsegs+4
	push	ax
	call	near ptr _MM_FreePtr
	pop	cx
	mov	ax,seg _grneeded
	mov	es,ax
	mov	al,byte ptr es:_grneeded+2
	mov	dl,byte ptr DGROUP:_ca_levelbit
	not	dl
	and	al,dl
	mov	dx,seg _grneeded
	mov	es,dx
	mov	byte ptr es:_grneeded+2,al
   ;	
