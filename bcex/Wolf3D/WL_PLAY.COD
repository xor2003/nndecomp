_GetNewActor	endp
   ;	
   ;	void RemoveObj (objtype *gone)
   ;	
	assume	cs:_TEXT
_RemoveObj	proc	near
	push	bp
	mov	bp,sp
	push	si
	mov	si,word ptr [bp+4]
   ;	
   ;	{
   ;		objtype **spotat;
   ;	
   ;		if (gone == player)
   ;	
	cmp	si,word ptr DGROUP:_player
	jne	short @12@74
   ;	
   ;			Quit ("RemoveObj: Tried to remove the player!");
   ;	
	mov	ax,offset DGROUP:s@+335
	push	ax
	call	near ptr _Quit
	pop	cx
@12@74:
   ;	
   ;	
   ;		gone->state = NULL;
   ;	
	mov	word ptr [si+6],0
   ;	
   ;	
   ;	//
   ;	// fix the next object's back link
   ;	//
   ;		if (gone == lastobj)
   ;	
	cmp	si,word ptr DGROUP:_lastobj
	jne	short @12@122
   ;	
   ;			lastobj = (objtype *)gone->prev;
   ;	
	mov	ax,word ptr [si+56]
	mov	word ptr DGROUP:_lastobj,ax
	jmp	short @12@146
@12@122:
   ;	
   ;		else
   ;			gone->next->prev = gone->prev;
   ;	
	mov	ax,word ptr [si+56]
	mov	bx,word ptr [si+54]
	mov	word ptr [bx+56],ax
@12@146:
   ;	
   ;	
   ;	//
   ;	// fix the previous object's forward link
   ;	//
   ;		gone->prev->next = gone->next;
   ;	
	mov	ax,word ptr [si+54]
	mov	bx,word ptr [si+56]
	mov	word ptr [bx+54],ax
   ;	
   ;	
   ;	//
   ;	// add it back in to the free list
   ;	//
   ;		gone->prev = objfreelist;
   ;	
	mov	ax,word ptr DGROUP:_objfreelist
	mov	word ptr [si+56],ax
   ;	
   ;		objfreelist = gone;
   ;	
	mov	word ptr DGROUP:_objfreelist,si
   ;	
   ;	
   ;		objcount--;
   ;	
	dec	word ptr DGROUP:_objcount
   ;	
   ;	}
   ;	
	pop	si
	pop	bp
	ret	
_RemoveObj	endp
