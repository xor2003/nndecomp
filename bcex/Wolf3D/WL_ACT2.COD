   ;	
   ;	void T_Schabb (objtype *ob)
   ;	
	assume	cs:_TEXT
_T_Schabb	proc	near
	push	bp
	mov	bp,sp
	sub	sp,10
	push	si
	push	di
	mov	si,word ptr [bp+4]
   ;	
   ;	{
   ;		long move;
   ;		int	dx,dy,dist;
   ;		boolean	dodge;
   ;	
   ;		dodge = false;
   ;	
	xor	di,di
   ;	
   ;		dx = abs(ob->tilex - player->tilex);
   ;	
	mov	ax,word ptr [si+23]
	mov	bx,word ptr DGROUP:_player
	sub	ax,word ptr [bx+23]
	cwd	
	xor	ax,dx
	sub	ax,dx
	mov	word ptr [bp-6],ax
   ;	
   ;		dy = abs(ob->tiley - player->tiley);
   ;	
	mov	ax,word ptr [si+25]
	mov	bx,word ptr DGROUP:_player
	sub	ax,word ptr [bx+25]
	cwd	
	xor	ax,dx
	sub	ax,dx
	mov	word ptr [bp-8],ax
   ;	
   ;		dist = dx>dy ? dx : dy;
   ;	
	mov	ax,word ptr [bp-6]
	cmp	ax,word ptr [bp-8]
	jle	short @16@74
	mov	ax,word ptr [bp-6]
	jmp	short @16@98
@16@74:
	mov	ax,word ptr [bp-8]
@16@98:
	mov	word ptr [bp-10],ax
   ;	
   ;	
   ;		if (CheckLine(ob))						// got a shot at player?
   ;	
	push	si
	call	near ptr _CheckLine
	pop	cx
	or	ax,ax
	je	short @16@194
   ;	
   ;		{
   ;	
   ;			if ( US_RndT() < (tics<<3) )
   ;	
	call	near ptr _US_RndT
	mov	dx,word ptr DGROUP:_tics
	shl	dx,1
	shl	dx,1
	shl	dx,1
	cmp	ax,dx
	jae	short @16@170
   ;	
   ;			{
   ;			//
   ;			// go into attack frame
   ;			//
   ;				NewState (ob,&s_schabbshoot1);
   ;	
	mov	ax,offset DGROUP:_s_schabbshoot1
	push	ax
	push	si
	call	near ptr _NewState
	pop	cx
	pop	cx
   ;	
   ;				return;
   ;	
	jmp	@16@794
@16@170:
   ;	
   ;			}
   ;			dodge = true;
   ;	
	mov	di,1
@16@194:
   ;	
   ;		}
   ;	
   ;		if (ob->dir == nodir)
   ;	
	cmp	word ptr [si+13],8
	jne	short @16@338
   ;	
   ;		{
   ;			if (dodge)
   ;	
	or	di,di
	je	short @16@266
   ;	
   ;				SelectDodgeDir (ob);
   ;	
	push	si
	call	near ptr _SelectDodgeDir
	pop	cx
	jmp	short @16@290
@16@266:
   ;	
   ;			else
   ;				SelectChaseDir (ob);
   ;	
	push	si
	call	near ptr _SelectChaseDir
	pop	cx
@16@290:
   ;	
   ;			if (ob->dir == nodir)
   ;	
	cmp	word ptr [si+13],8
	jne	short @16@338
   ;	
   ;				return;							// object is blocked in
   ;	
	jmp	@16@794
@16@338:
   ;	
   ;		}
   ;	
   ;		move = ob->speed*tics;
   ;	
	mov	cx,word ptr [si+46]
	mov	bx,word ptr [si+44]
	mov	ax,word ptr DGROUP:_tics
	xor	dx,dx
	call	near ptr N_LXMUL@
	mov	word ptr [bp-4],ax
	mov	word ptr [bp-2],dx
	jmp	@16@770
@16@362:
   ;	
   ;	
   ;		while (move)
   ;		{
   ;			if (ob->distance < 0)
   ;	
	cmp	word ptr [si+11],0
	jg	short @16@506
	jl	short @16@434
	cmp	word ptr [si+9],0
	jae	short @16@506
@16@434:
   ;	
   ;			{
   ;			//
   ;			// waiting for a door to open
   ;			//
   ;				OpenDoor (-ob->distance-1);
   ;	
	mov	ax,word ptr [si+9]
	neg	ax
	dec	ax
	push	ax
	call	near ptr _OpenDoor
	pop	cx
   ;	
   ;				if (doorobjlist[-ob->distance-1].action != dr_open)
   ;	
	mov	ax,word ptr [si+9]
	neg	ax
	mov	dx,9
	imul	dx
	mov	bx,ax
	cmp	word ptr DGROUP:_doorobjlist[bx-4],0
	je	short @16@482
   ;	
   ;					return;
   ;	
	jmp	@16@794
@16@482:
   ;	
   ;				ob->distance = TILEGLOBAL;	// go ahead, the door is now opoen
   ;	
	mov	word ptr [si+9],0
	mov	word ptr [si+11],1
@16@506:
   ;	
   ;			}
   ;	
   ;			if (move < ob->distance)
   ;	
	mov	ax,word ptr [si+11]
	mov	dx,word ptr [si+9]
	cmp	ax,word ptr [bp-2]
	jl	short @16@602
	jg	short @16@578
	cmp	dx,word ptr [bp-4]
	jbe	short @16@602
@16@578:
   ;	
   ;			{
   ;				MoveObj (ob,move);
   ;	
	push	word ptr [bp-2]
	push	word ptr [bp-4]
	push	si
	call	near ptr _MoveObj
	add	sp,6
   ;	
   ;				break;
   ;	
	jmp	short @16@794
@16@602:
   ;	
   ;			}
   ;	
   ;			//
   ;			// reached goal tile, so select another one
   ;			//
   ;	
   ;			//
   ;			// fix position to account for round off during moving
   ;			//
   ;			ob->x = ((long)ob->tilex<<TILESHIFT)+TILEGLOBAL/2;
   ;	
	mov	ax,word ptr [si+23]
	xor	dx,dx
	add	dx,32768
	adc	ax,0
	mov	word ptr [si+15],dx
	mov	word ptr [si+17],ax
   ;	
   ;			ob->y = ((long)ob->tiley<<TILESHIFT)+TILEGLOBAL/2;
   ;	
	mov	ax,word ptr [si+25]
	xor	dx,dx
	add	dx,32768
	adc	ax,0
	mov	word ptr [si+19],dx
	mov	word ptr [si+21],ax
   ;	
   ;	
   ;			move -= ob->distance;
   ;	
	mov	ax,word ptr [si+11]
	mov	dx,word ptr [si+9]
	sub	word ptr [bp-4],dx
	sbb	word ptr [bp-2],ax
   ;	
   ;	
   ;			if (dist <4)
   ;	
	cmp	word ptr [bp-10],4
	jge	short @16@650
   ;	
   ;				SelectRunDir (ob);
   ;	
	push	si
	call	near ptr _SelectRunDir
	pop	cx
	jmp	short @16@722
@16@650:
   ;	
   ;			else if (dodge)
   ;	
	or	di,di
	je	short @16@698
   ;	
   ;				SelectDodgeDir (ob);
   ;	
	push	si
	call	near ptr _SelectDodgeDir
	pop	cx
	jmp	short @16@722
@16@698:
   ;	
   ;			else
   ;				SelectChaseDir (ob);
   ;	
	push	si
	call	near ptr _SelectChaseDir
	pop	cx
@16@722:
   ;	
   ;	
   ;			if (ob->dir == nodir)
   ;	
	cmp	word ptr [si+13],8
	jne	short @16@770
   ;	
   ;				return;							// object is blocked in
   ;	
	jmp	short @16@794
@16@770:
	mov	ax,word ptr [bp-4]
	or	ax,word ptr [bp-2]
	je	@@4
	jmp	@16@362
@@4:
@16@794:
   ;	
   ;		}
   ;	
   ;	}
   ;	
	pop	di
	pop	si
	mov	sp,bp
	pop	bp
	ret	
_T_Schabb	endp
   ;	
   ;	=================================================================
   ;	
	assume	cs:_TEXT
_T_Gift	proc	near
	push	bp
	mov	bp,sp
	sub	sp,10
	push	si
	push	di
	mov	si,word ptr [bp+4]
   ;	
   ;	
   ;							 LOCAL CONSTANTS
   ;	
   ;	=============================================================================
   ;	*/
   ;	
   ;	
	xor	di,di
   ;	
   ;	#define PROJECTILESIZE	0xc000l
   ;	
	mov	ax,word ptr [si+23]
	mov	bx,word ptr DGROUP:_player
	sub	ax,word ptr [bx+23]
	cwd	
	xor	ax,dx
	sub	ax,dx
	mov	word ptr [bp-6],ax
   ;	
   ;	
   ;	
	mov	ax,word ptr [si+25]
	mov	bx,word ptr DGROUP:_player
	sub	ax,word ptr [bx+25]
	cwd	
	xor	ax,dx
	sub	ax,dx
	mov	word ptr [bp-8],ax
   ;	
   ;	#define BJRUNSPEED	2048
   ;	
	mov	ax,word ptr [bp-6]
	cmp	ax,word ptr [bp-8]
	jle	short @17@74
	mov	ax,word ptr [bp-6]
	jmp	short @17@98
@17@74:
	mov	ax,word ptr [bp-8]
@17@98:
	mov	word ptr [bp-10],ax
   ;	
   ;	#define BJJUMPSPEED	680
   ;	
   ;	
	push	si
	call	near ptr _CheckLine
	pop	cx
	or	ax,ax
	je	short @17@194
   ;	
   ;	
   ;	/*
   ;	=============================================================================
   ;	
	call	near ptr _US_RndT
	mov	dx,word ptr DGROUP:_tics
	shl	dx,1
	shl	dx,1
	shl	dx,1
	cmp	ax,dx
	jae	short @17@170
   ;	
   ;	
   ;							 GLOBAL VARIABLES
   ;	
   ;	=============================================================================
   ;	*/
   ;	
	mov	ax,offset DGROUP:_s_giftshoot1
	push	ax
	push	si
	call	near ptr _NewState
	pop	cx
	pop	cx
   ;	
   ;	
   ;	
	jmp	@17@794
@17@170:
   ;	
   ;	
   ;	
   ;	
	mov	di,1
@17@194:
   ;	
   ;	/*
   ;	=============================================================================
   ;	
   ;	
	cmp	word ptr [si+13],8
	jne	short @17@338
   ;	
   ;							 LOCAL VARIABLES
   ;	
   ;	
	or	di,di
	je	short @17@266
   ;	
   ;	=============================================================================
   ;	
	push	si
	call	near ptr _SelectDodgeDir
	pop	cx
	jmp	short @17@290
@17@266:
   ;	
   ;	*/
   ;	
   ;	
	push	si
	call	near ptr _SelectChaseDir
	pop	cx
@17@290:
   ;	
   ;	
   ;	
	cmp	word ptr [si+13],8
	jne	short @17@338
   ;	
   ;	dirtype dirtable[9] = {northwest,north,northeast,west,nodir,east,
   ;	
	jmp	@17@794
@17@338:
   ;	
   ;		southwest,south,southeast};
   ;	
   ;	int	starthitpoints[4][NUMENEMIES] =
   ;	
	mov	cx,word ptr [si+46]
	mov	bx,word ptr [si+44]
	mov	ax,word ptr DGROUP:_tics
	xor	dx,dx
	call	near ptr N_LXMUL@
	mov	word ptr [bp-4],ax
	mov	word ptr [bp-2],dx
	jmp	@17@770
@17@362:
   ;	
   ;		 //
   ;		 // BABY MODE
   ;		 //
   ;		 {
   ;	
	cmp	word ptr [si+11],0
	jg	short @17@506
	jl	short @17@434
	cmp	word ptr [si+9],0
	jae	short @17@506
@17@434:
   ;	
   ;		 {25,	// guards
   ;		  50,	// officer
   ;		  100,	// SS
   ;		  1,	// dogs
   ;		  850,	// Hans
   ;	
	mov	ax,word ptr [si+9]
	neg	ax
	dec	ax
	push	ax
	call	near ptr _OpenDoor
	pop	cx
   ;	
   ;		  850,	// Schabbs
   ;	
	mov	ax,word ptr [si+9]
	neg	ax
	mov	dx,9
	imul	dx
	mov	bx,ax
	cmp	word ptr DGROUP:_doorobjlist[bx-4],0
	je	short @17@482
   ;	
   ;		  200,	// fake hitler
   ;	
	jmp	@17@794
@17@482:
   ;	
   ;		  800,	// mecha hitler
   ;	
	mov	word ptr [si+9],0
	mov	word ptr [si+11],1
@17@506:
   ;	
   ;		  45,	// mutants
   ;		  25,	// ghosts
   ;		  25,	// ghosts
   ;	
	mov	ax,word ptr [si+11]
	mov	dx,word ptr [si+9]
	cmp	ax,word ptr [bp-2]
	jl	short @17@602
	jg	short @17@578
	cmp	dx,word ptr [bp-4]
	jbe	short @17@602
@17@578:
   ;	
   ;		  25,	// ghosts
   ;		  25,	// ghosts
   ;	
	push	word ptr [bp-2]
	push	word ptr [bp-4]
	push	si
	call	near ptr _MoveObj
	add	sp,6
   ;	
   ;	
   ;	
	jmp	short @17@794
@17@602:
   ;	
   ;		  850,	// Gretel
   ;		  850,	// Gift
   ;		  850,	// Fat
   ;		  5,	// en_spectre,
   ;		  1450,	// en_angel,
   ;		  850,	// en_trans,
   ;		  1050,	// en_uber,
   ;		  950,	// en_will,
   ;		  1250	// en_death
   ;		  },
   ;	
	mov	ax,word ptr [si+23]
	xor	dx,dx
	add	dx,32768
	adc	ax,0
	mov	word ptr [si+15],dx
	mov	word ptr [si+17],ax
   ;	
   ;		 //
   ;	
	mov	ax,word ptr [si+25]
	xor	dx,dx
	add	dx,32768
	adc	ax,0
	mov	word ptr [si+19],dx
	mov	word ptr [si+21],ax
   ;	
   ;		 // DON'T HURT ME MODE
   ;		 //
   ;	
	mov	ax,word ptr [si+11]
	mov	dx,word ptr [si+9]
	sub	word ptr [bp-4],dx
	sbb	word ptr [bp-2],ax
   ;	
   ;		 {25,	// guards
   ;		  50,	// officer
   ;	
	cmp	word ptr [bp-10],4
	jge	short @17@650
   ;	
   ;		  100,	// SS
   ;	
	push	si
	call	near ptr _SelectRunDir
	pop	cx
	jmp	short @17@722
@17@650:
   ;	
   ;		  1,	// dogs
   ;	
	or	di,di
	je	short @17@698
   ;	
   ;		  950,	// Hans
   ;	
	push	si
	call	near ptr _SelectDodgeDir
	pop	cx
	jmp	short @17@722
@17@698:
   ;	
   ;		  950,	// Schabbs
   ;		  300,	// fake hitler
   ;	
	push	si
	call	near ptr _SelectChaseDir
	pop	cx
@17@722:
   ;	
   ;		  950,	// mecha hitler
   ;		  55,	// mutants
   ;	
	cmp	word ptr [si+13],8
	jne	short @17@770
   ;	
   ;		  25,	// ghosts
   ;	
	jmp	short @17@794
@17@770:
	mov	ax,word ptr [bp-4]
	or	ax,word ptr [bp-2]
	je	@@5
	jmp	@17@362
@@5:
@17@794:
   ;	
   ;		  25,	// ghosts
   ;		  25,	// ghosts
   ;		  25,	// ghosts
   ;	
	pop	di
	pop	si
	mov	sp,bp
	pop	bp
	ret	
_T_Gift	endp
   ;	
