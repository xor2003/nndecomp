   ;	
   ;	void SpawnGhosts (int which, int tilex, int tiley)
   ;	
	assume	cs:_TEXT
_SpawnGhosts	proc	near
	push	bp
	mov	bp,sp
	push	si
	push	di
	mov	di,word ptr [bp+6]
	mov	si,word ptr [bp+8]
   ;	
   ;	{
   ;		unsigned	far *map,tile;
   ;	
   ;		switch(which)
   ;	
	mov	bx,word ptr [bp+4]
	sub	bx,9
	cmp	bx,3
	ja	short @10@194
	shl	bx,1
	jmp	word ptr cs:@10@C922[bx]
@10@98:
   ;	
   ;		{
   ;		 case en_blinky:
   ;		   SpawnNewObj (tilex,tiley,&s_blinkychase1);
   ;	
	mov	ax,offset DGROUP:_s_blinkychase1
	push	ax
	push	si
	push	di
	call	near ptr _SpawnNewObj
	add	sp,6
   ;	
   ;		   break;
   ;	
	jmp	short @10@194
@10@122:
   ;	
   ;		 case en_clyde:
   ;		   SpawnNewObj (tilex,tiley,&s_clydechase1);
   ;	
	mov	ax,offset DGROUP:_s_clydechase1
	push	ax
	push	si
	push	di
	call	near ptr _SpawnNewObj
	add	sp,6
   ;	
   ;		   break;
   ;	
	jmp	short @10@194
@10@146:
   ;	
   ;		 case en_pinky:
   ;		   SpawnNewObj (tilex,tiley,&s_pinkychase1);
   ;	
	mov	ax,offset DGROUP:_s_pinkychase1
	push	ax
	push	si
	push	di
	call	near ptr _SpawnNewObj
	add	sp,6
   ;	
   ;		   break;
   ;	
	jmp	short @10@194
@10@170:
   ;	
   ;		 case en_inky:
   ;		   SpawnNewObj (tilex,tiley,&s_inkychase1);
   ;	
	mov	ax,offset DGROUP:_s_inkychase1
	push	ax
	push	si
	push	di
	call	near ptr _SpawnNewObj
	add	sp,6
   ;	
   ;		   break;
   ;	
	jmp	short @10@194
@10@194:
   ;	
   ;		}
   ;	
   ;		new->obclass = ghostobj;
   ;	
	mov	bx,word ptr DGROUP:_new
	mov	word ptr [bx+4],15
   ;	
   ;		new->speed = SPDDOG;
   ;	
	mov	bx,word ptr DGROUP:_new
	mov	word ptr [bx+44],1500
	mov	word ptr [bx+46],0
   ;	
   ;	
   ;		new->dir = east;
   ;	
	mov	bx,word ptr DGROUP:_new
	mov	word ptr [bx+13],0
   ;	
   ;		new->flags |= FL_AMBUSH;
   ;	
	mov	bx,word ptr DGROUP:_new
	mov	al,byte ptr [bx+8]
	or	al,64
	mov	bx,word ptr DGROUP:_new
	mov	byte ptr [bx+8],al
   ;	
   ;		if (!loadedgame)
   ;	
	cmp	word ptr DGROUP:_loadedgame,0
	jne	short @10@242
   ;	
   ;		  gamestate.killtotal++;
   ;	
	inc	word ptr DGROUP:_gamestate+50
@10@242:
   ;	
   ;	}
   ;	
	pop	di
	pop	si
	pop	bp
	ret	
_SpawnGhosts	endp
