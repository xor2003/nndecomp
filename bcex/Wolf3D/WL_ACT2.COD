	mov	word ptr [bx+9],dx
	mov	word ptr [bx+11],ax
   ;	
   ;	statetype s_dogjump3 	= {false,SPR_DOG_JUMP3,10,NULL,NULL,&s_dogjump4};
   ;	
	mov	ax,word ptr [si+13]
