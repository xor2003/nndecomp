	mov	ax,word ptr [si+21]
	cwd	
	mov	word ptr [si+25],ax
@3@986:
   ;	
   ;	
   ;	}
   ;	
	pop	di
	pop	si
	mov	sp,bp
	pop	bp
	ret	
