   ;	
   ;		  100,	// SS
   ;	
	jmp	@18@794
@18@170:
   ;	
   ;		  1,	// dogs
   ;	
   ;	
	mov	di,1
@18@194:
   ;	
   ;		  1050,	// Hans
   ;		  1550,	// Schabbs
   ;		  400,	// fake hitler
   ;	
	cmp	word ptr [si+13],8
	jne	short @18@338
   ;	
