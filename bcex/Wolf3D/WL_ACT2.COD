_SpawnFakeHitler	proc	near
	push	bp
	mov	bp,sp
   ;	
   ;	
   ;	statetype s_pinkychase1 	= {false,SPR_PINKY_W1,10,T_Ghosts,NULL,&s_pinkychase2};
   ;	statetype s_pinkychase2 	= {false,SPR_PINKY_W2,10,T_Ghosts,NULL,&s_pinkychase1};
   ;	
   ;	statetype s_clydechase1 	= {false,SPR_CLYDE_W1,10,T_Ghosts,NULL,&s_clydechase2};
   ;	
	cmp	word ptr DGROUP:_DigiMode,0
	je	short @19@74
   ;	
   ;	statetype s_clydechase2 	= {false,SPR_CLYDE_W2,10,T_Ghosts,NULL,&s_clydechase1};
   ;	
	mov	word ptr DGROUP:_s_hitlerdie2+4,140
	jmp	short @19@98
@19@74:
   ;	
   ;	#endif
   ;	
   ;	
	mov	word ptr DGROUP:_s_hitlerdie2+4,5
@19@98:
   ;	
   ;	//
   ;	// dogs
   ;	
	mov	ax,offset DGROUP:_s_fakestand
	push	ax
	push	word ptr [bp+6]
	push	word ptr [bp+4]
	call	near ptr _SpawnNewObj
	add	sp,6
   ;	
   ;	//
   ;	
	mov	bx,word ptr DGROUP:_new
	mov	word ptr [bx+44],512
	mov	word ptr [bx+46],0
   ;	
   ;	
   ;	extern	statetype s_dogpath1;
   ;	
	mov	bx,word ptr DGROUP:_new
	mov	word ptr [bx+4],9
   ;	
   ;	extern	statetype s_dogpath1s;
   ;	
	mov	ax,word ptr DGROUP:_gamestate
	mov	dx,44
	imul	dx
	mov	bx,ax
	mov	ax,word ptr DGROUP:_starthitpoints[bx+12]
	mov	bx,word ptr DGROUP:_new
	mov	word ptr [bx+42],ax
   ;	
   ;	extern	statetype s_dogpath2;
   ;	
	mov	bx,word ptr DGROUP:_new
	mov	word ptr [bx+13],2
   ;	
   ;	extern	statetype s_dogpath3;
   ;	
	mov	bx,word ptr DGROUP:_new
	mov	al,byte ptr [bx+8]
	or	al,65
	mov	bx,word ptr DGROUP:_new
	mov	byte ptr [bx+8],al
   ;	
   ;	extern	statetype s_dogpath3s;
   ;	
	cmp	word ptr DGROUP:_loadedgame,0
	jne	short @19@146
   ;	
   ;	extern	statetype s_dogpath4;
   ;	
	inc	word ptr DGROUP:_gamestate+50
@19@146:
   ;	
   ;	
   ;	
	pop	bp
	ret	
_SpawnFakeHitler	endp
