_DATA	ends
_TEXT	segment byte public 'CODE'
   ;	
   ;	void SpawnStand (enemy_t which, int tilex, int tiley, int dir)
   ;	
	assume	cs:_TEXT
_SpawnStand	proc	near
	push	bp
	mov	bp,sp
	sub	sp,6
	push	si
	push	di
	mov	di,word ptr [bp+6]
	mov	si,word ptr [bp+8]
   ;	
   ;	{
   ;		unsigned	far *map,tile;
   ;	
   ;		switch (which)
   ;	
	mov	bx,word ptr [bp+4]
	cmp	bx,8
	jbe	@@0
	jmp	@4@386
@@0:
	shl	bx,1
	jmp	word ptr cs:@4@C2072[bx]
@4@98:
   ;	
   ;		{
   ;		case en_guard:
   ;			SpawnNewObj (tilex,tiley,&s_grdstand);
   ;	
	mov	ax,offset DGROUP:_s_grdstand
	push	ax
	push	si
	push	di
	call	near ptr _SpawnNewObj
	add	sp,6
   ;	
   ;			new->speed = SPDPATROL;
   ;	
	mov	bx,word ptr DGROUP:_new
	mov	word ptr [bx+44],512
	mov	word ptr [bx+46],0
   ;	
   ;			if (!loadedgame)
   ;	
	cmp	word ptr DGROUP:_loadedgame,0
	jne	short @4@146
   ;	
   ;			  gamestate.killtotal++;
   ;	
	inc	word ptr DGROUP:_gamestate+50
@4@146:
   ;	
   ;			break;
   ;	
	jmp	short @4@386
@4@170:
   ;	
   ;	
   ;		case en_officer:
   ;			SpawnNewObj (tilex,tiley,&s_ofcstand);
   ;	
	mov	ax,offset DGROUP:_s_ofcstand
	push	ax
	push	si
	push	di
	call	near ptr _SpawnNewObj
	add	sp,6
   ;	
   ;			new->speed = SPDPATROL;
   ;	
	mov	bx,word ptr DGROUP:_new
	mov	word ptr [bx+44],512
	mov	word ptr [bx+46],0
   ;	
   ;			if (!loadedgame)
   ;	
	cmp	word ptr DGROUP:_loadedgame,0
	jne	short @4@218
   ;	
   ;			  gamestate.killtotal++;
   ;	
	inc	word ptr DGROUP:_gamestate+50
@4@218:
   ;	
   ;			break;
   ;	
	jmp	short @4@386
@4@242:
   ;	
   ;	
   ;		case en_mutant:
   ;			SpawnNewObj (tilex,tiley,&s_mutstand);
   ;	
	mov	ax,offset DGROUP:_s_mutstand
	push	ax
	push	si
	push	di
	call	near ptr _SpawnNewObj
	add	sp,6
   ;	
   ;			new->speed = SPDPATROL;
   ;	
	mov	bx,word ptr DGROUP:_new
	mov	word ptr [bx+44],512
	mov	word ptr [bx+46],0
   ;	
   ;			if (!loadedgame)
   ;	
	cmp	word ptr DGROUP:_loadedgame,0
	jne	short @4@290
   ;	
   ;			  gamestate.killtotal++;
   ;	
	inc	word ptr DGROUP:_gamestate+50
@4@290:
   ;	
   ;			break;
   ;	
	jmp	short @4@386
@4@314:
   ;	
   ;	
   ;		case en_ss:
   ;			SpawnNewObj (tilex,tiley,&s_ssstand);
   ;	
	mov	ax,offset DGROUP:_s_ssstand
	push	ax
	push	si
	push	di
	call	near ptr _SpawnNewObj
	add	sp,6
   ;	
   ;			new->speed = SPDPATROL;
   ;	
	mov	bx,word ptr DGROUP:_new
	mov	word ptr [bx+44],512
	mov	word ptr [bx+46],0
   ;	
   ;			if (!loadedgame)
   ;	
	cmp	word ptr DGROUP:_loadedgame,0
	jne	short @4@362
   ;	
   ;			  gamestate.killtotal++;
   ;	
	inc	word ptr DGROUP:_gamestate+50
@4@362:
   ;	
   ;			break;
   ;	
	jmp	short @4@386
@4@386:
   ;	
   ;		}
   ;	
   ;	
   ;		map = mapsegs[0]+farmapylookup[tiley]+tilex;
   ;	
	mov	bx,si
	shl	bx,1
	mov	ax,word ptr DGROUP:_farmapylookup[bx]
	shl	ax,1
	mov	dx,word ptr DGROUP:_mapsegs
	mov	bx,di
	shl	bx,1
	add	ax,bx
	mov	word ptr [bp-4],ax
	mov	word ptr [bp-2],dx
   ;	
   ;		if (*map == AMBUSHTILE)
   ;	
	les	bx,dword ptr [bp-4]
	cmp	word ptr es:[bx],106
	je	@@1
	jmp	@4@626
@@1:
   ;	
   ;		{
