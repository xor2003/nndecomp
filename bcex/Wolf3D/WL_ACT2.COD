   ;	
   ;	void T_SchabbThrow (objtype *ob)
   ;	
	assume	cs:_TEXT
_T_SchabbThrow	proc	near
	push	bp
	mov	bp,sp
	sub	sp,16
	push	si
	push	di
	mov	si,word ptr [bp+4]
   ;	
   ;	{
   ;		long	deltax,deltay;
   ;		float	angle;
   ;		int		iangle;
   ;	
   ;		deltax = player->x - ob->x;
   ;	
	mov	bx,word ptr DGROUP:_player
	mov	ax,word ptr [bx+17]
	mov	dx,word ptr [bx+15]
	sub	dx,word ptr [si+15]
	sbb	ax,word ptr [si+17]
	mov	word ptr [bp-4],dx
	mov	word ptr [bp-2],ax
   ;	
   ;		deltay = ob->y - player->y;
   ;	
	mov	ax,word ptr [si+21]
	mov	dx,word ptr [si+19]
	mov	bx,word ptr DGROUP:_player
	sub	dx,word ptr [bx+19]
	sbb	ax,word ptr [bx+21]
	mov	word ptr [bp-8],dx
	mov	word ptr [bp-6],ax
   ;	
   ;		angle = atan2 (deltay,deltax);
   ;	
	mov	ax,word ptr [bp-2]
	mov	dx,word ptr [bp-4]
	mov	word ptr [bp-16],dx
	mov	word ptr [bp-14],ax
	FILD	dword ptr [bp-16]
	add	sp,65528
	FSTP	qword ptr [bp-28]
	FWAIT	
	mov	ax,word ptr [bp-6]
	mov	dx,word ptr [bp-8]
	mov	word ptr [bp-16],dx
	mov	word ptr [bp-14],ax
	FILD	dword ptr [bp-16]
	add	sp,65528
	FSTP	qword ptr [bp-36]
	FWAIT	
	call	near ptr _atan2
	add	sp,16
	FSTP	dword ptr [bp-12]
   ;	
   ;		if (angle<0)
   ;	
	FLD	dword ptr [bp-12]
	FLDZ	
	FCOMPP
	FSTSW	word ptr [bp-16]
	FWAIT	
	mov	ax,word ptr [bp-16]
	sahf	
	jbe	short @14@74
   ;	
   ;			angle = M_PI*2+angle;
   ;	
	FLD	dword ptr [bp-12]
	FADD	qword ptr DGROUP:s@
	FSTP	dword ptr [bp-12]
	FWAIT	
@14@74:
   ;	
   ;		iangle = angle/(M_PI*2)*ANGLES;
   ;	
	FLD	dword ptr [bp-12]
	FDIV	qword ptr DGROUP:s@
	FMUL	dword ptr DGROUP:s@+8
	call	near ptr N_FTOL@
	mov	di,ax
   ;	
   ;	
   ;		GetNewActor ();
   ;	
	call	near ptr _GetNewActor
   ;	
   ;		new->state = &s_needle1;
   ;	
	mov	bx,word ptr DGROUP:_new
	mov	word ptr [bx+6],offset DGROUP:_s_needle1
   ;	
   ;		new->ticcount = 1;
   ;	
	mov	bx,word ptr DGROUP:_new
	mov	word ptr [bx+2],1
   ;	
   ;	
   ;		new->tilex = ob->tilex;
   ;	
	mov	ax,word ptr [si+23]
	mov	bx,word ptr DGROUP:_new
	mov	word ptr [bx+23],ax
   ;	
   ;		new->tiley = ob->tiley;
   ;	
	mov	ax,word ptr [si+25]
	mov	bx,word ptr DGROUP:_new
	mov	word ptr [bx+25],ax
   ;	
   ;		new->x = ob->x;
   ;	
	mov	ax,word ptr [si+17]
	mov	dx,word ptr [si+15]
	mov	bx,word ptr DGROUP:_new
	mov	word ptr [bx+15],dx
	mov	word ptr [bx+17],ax
   ;	
   ;		new->y = ob->y;
   ;	
	mov	ax,word ptr [si+21]
	mov	dx,word ptr [si+19]
	mov	bx,word ptr DGROUP:_new
	mov	word ptr [bx+19],dx
	mov	word ptr [bx+21],ax
   ;	
   ;		new->obclass = needleobj;
   ;	
	mov	bx,word ptr DGROUP:_new
	mov	word ptr [bx+4],12
   ;	
   ;		new->dir = nodir;
   ;	
	mov	bx,word ptr DGROUP:_new
	mov	word ptr [bx+13],8
   ;	
   ;		new->angle = iangle;
   ;	
	mov	bx,word ptr DGROUP:_new
	mov	word ptr [bx+40],di
   ;	
   ;		new->speed = 0x2000l;
   ;	
	mov	bx,word ptr DGROUP:_new
	mov	word ptr [bx+44],8192
	mov	word ptr [bx+46],0
   ;	
   ;	
   ;		new->flags = FL_NONMARK;
   ;	
	mov	bx,word ptr DGROUP:_new
	mov	byte ptr [bx+8],128
   ;	
   ;		new->active = true;
   ;	
	mov	bx,word ptr DGROUP:_new
	mov	word ptr [bx],1
   ;	
   ;	
   ;		PlaySoundLocActor (SCHABBSTHROWSND,new);
   ;	
	mov	bx,word ptr DGROUP:_new
	push	word ptr [bx+21]
	push	word ptr [bx+19]
	mov	bx,word ptr DGROUP:_new
	push	word ptr [bx+17]
	push	word ptr [bx+15]
	mov	ax,8
	push	ax
	call	near ptr _PlaySoundLocGlobal
	add	sp,10
   ;	
   ;	}
   ;	
	pop	di
	pop	si
	mov	sp,bp
	pop	bp
	ret	
_T_SchabbThrow	endp
