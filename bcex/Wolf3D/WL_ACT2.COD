   ;	
	call	near ptr _US_RndT
	mov	dx,word ptr DGROUP:_tics
	shl	dx,1
	shl	dx,1
	shl	dx,1
	cmp	ax,dx
	jae	short @18@170
   ;	
   ;		 //
   ;		 // BRING 'EM ON MODE
   ;		 //
