_TEXT	segment byte public 'CODE'
   ;	
   ;	void SpawnSchabbs (int tilex, int tiley)
   ;	
	assume	cs:_TEXT
_SpawnSchabbs	proc	near
	push	bp
	mov	bp,sp
   ;	
   ;	{
   ;		unsigned	far *map,tile;
   ;	
   ;		if (DigiMode != sds_Off)
   ;	
	cmp	word ptr DGROUP:_DigiMode,0
	je	short @11@74
   ;	
   ;			s_schabbdie2.tictime = 140;
   ;	
	mov	word ptr DGROUP:_s_schabbdie2+4,140
	jmp	short @11@98
@11@74:
   ;	
   ;		else
   ;			s_schabbdie2.tictime = 5;
   ;	
	mov	word ptr DGROUP:_s_schabbdie2+4,5
@11@98:
   ;	
   ;	
   ;		SpawnNewObj (tilex,tiley,&s_schabbstand);
   ;	
	mov	ax,offset DGROUP:_s_schabbstand
	push	ax
	push	word ptr [bp+6]
	push	word ptr [bp+4]
	call	near ptr _SpawnNewObj
	add	sp,6
   ;	
   ;		new->speed = SPDPATROL;
   ;	
	mov	bx,word ptr DGROUP:_new
