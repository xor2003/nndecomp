_TEXT	segment byte public 'CODE'
   ;	
   ;	void A_Smoke (objtype *ob)
   ;	
	assume	cs:_TEXT
_A_Smoke	proc	near
	push	bp
	mov	bp,sp
	push	si
	mov	si,word ptr [bp+4]
   ;	
   ;	{
   ;		GetNewActor ();
   ;	
	call	near ptr _GetNewActor
   ;	
   ;	#ifdef SPEAR
   ;		if (ob->obclass == hrocketobj)
   ;			new->state = &s_hsmoke1;
   ;		else
   ;	#endif
   ;			new->state = &s_smoke1;
   ;	
	mov	bx,word ptr DGROUP:_new
	mov	word ptr [bx+6],offset DGROUP:_s_smoke1
   ;	
   ;		new->ticcount = 6;
   ;	
	mov	bx,word ptr DGROUP:_new
	mov	word ptr [bx+2],6
   ;	
   ;	
   ;		new->tilex = ob->tilex;
   ;	
	mov	ax,word ptr [si+23]
	mov	bx,word ptr DGROUP:_new
	mov	word ptr [bx+23],ax
   ;	
   ;		new->tiley = ob->tiley;
   ;	
	mov	ax,word ptr [si+25]
	mov	bx,word ptr DGROUP:_new
	mov	word ptr [bx+25],ax
   ;	
   ;		new->x = ob->x;
   ;	
	mov	ax,word ptr [si+17]
	mov	dx,word ptr [si+15]
	mov	bx,word ptr DGROUP:_new
	mov	word ptr [bx+15],dx
	mov	word ptr [bx+17],ax
   ;	
   ;		new->y = ob->y;
   ;	
	mov	ax,word ptr [si+21]
	mov	dx,word ptr [si+19]
	mov	bx,word ptr DGROUP:_new
	mov	word ptr [bx+19],dx
	mov	word ptr [bx+21],ax
   ;	
   ;		new->obclass = inertobj;
   ;	
	mov	bx,word ptr DGROUP:_new
	mov	word ptr [bx+4],2
   ;	
   ;		new->active = true;
   ;	
	mov	bx,word ptr DGROUP:_new
	mov	word ptr [bx],1
   ;	
   ;	
   ;		new->flags = FL_NEVERMARK;
   ;	
	mov	bx,word ptr DGROUP:_new
	mov	byte ptr [bx+8],4
   ;	
   ;	}
   ;	
	pop	si
	pop	bp
	ret	
_A_Smoke	endp
   ;	
   ;	boolean ProjectileTryMove (objtype *ob)
   ;	
	assume	cs:_TEXT
_ProjectileTryMove	proc	near
	push	bp
	mov	bp,sp
	sub	sp,12
	push	si
	push	di
	mov	si,word ptr [bp+4]
   ;	
   ;	{
   ;		int			xl,yl,xh,yh,x,y;
   ;		objtype		*check;
   ;		long		deltax,deltay;
   ;	
   ;		xl = (ob->x-PROJSIZE) >>TILESHIFT;
   ;	
	mov	ax,word ptr [si+17]
	mov	dx,word ptr [si+15]
	add	dx,57344
	adc	ax,65535
	cwd	
	mov	word ptr [bp-2],ax
   ;	
   ;		yl = (ob->y-PROJSIZE) >>TILESHIFT;
   ;	
	mov	ax,word ptr [si+21]
	mov	dx,word ptr [si+19]
	add	dx,57344
	adc	ax,65535
	cwd	
	mov	word ptr [bp-4],ax
   ;	
   ;	
   ;		xh = (ob->x+PROJSIZE) >>TILESHIFT;
   ;	
	mov	ax,word ptr [si+17]
	mov	dx,word ptr [si+15]
	add	dx,8192
	adc	ax,0
	cwd	
	mov	word ptr [bp-6],ax
   ;	
   ;		yh = (ob->y+PROJSIZE) >>TILESHIFT;
   ;	
	mov	ax,word ptr [si+21]
	mov	dx,word ptr [si+19]
	add	dx,8192
	adc	ax,0
	cwd	
	mov	word ptr [bp-8],ax
   ;	
   ;	
   ;	//
   ;	// check for solid walls
   ;	//
   ;		for (y=yl;y<=yh;y++)
   ;	
	mov	di,word ptr [bp-4]
	jmp	short @2@218
@2@50:
   ;	
   ;			for (x=xl;x<=xh;x++)
   ;	
	mov	ax,word ptr [bp-2]
	mov	word ptr [bp-10],ax
	jmp	short @2@170
@2@74:
   ;	
   ;			{
   ;				check = actorat[x][y];
   ;	
	mov	bx,word ptr [bp-10]
	mov	cl,7
	shl	bx,cl
	mov	ax,di
	shl	ax,1
	add	bx,ax
	mov	ax,word ptr DGROUP:_actorat[bx]
	mov	word ptr [bp-12],ax
   ;	
   ;				if (check && check<objlist)
   ;	
	cmp	word ptr [bp-12],0
	je	short @2@146
	cmp	word ptr [bp-12],offset DGROUP:_objlist
	jae	short @2@146
   ;	
   ;					return false;
   ;	
	xor	ax,ax
	jmp	short @2@266
@2@146:
	inc	word ptr [bp-10]
@2@170:
	mov	ax,word ptr [bp-10]
	cmp	ax,word ptr [bp-6]
	jle	short @2@74
	inc	di
@2@218:
	cmp	di,word ptr [bp-8]
	jle	short @2@50
   ;	
   ;			}
   ;	
   ;		return true;
   ;	
	mov	ax,1
	jmp	short @2@266
@2@266:
   ;	
   ;	}
   ;	
	pop	di
	pop	si
	mov	sp,bp
	pop	bp
	ret	
_ProjectileTryMove	endp
   ;	
   ;	void T_Projectile (objtype *ob)
   ;	
	assume	cs:_TEXT
_T_Projectile	proc	near
	push	bp
	mov	bp,sp
	sub	sp,14
	push	si
	push	di
	mov	si,word ptr [bp+4]
   ;	
   ;	{
   ;		long	deltax,deltay;
   ;		int		damage;
   ;		long	speed;
   ;	
   ;		speed = (long)ob->speed*tics;
   ;	
	mov	cx,word ptr [si+46]
	mov	bx,word ptr [si+44]
	mov	ax,word ptr DGROUP:_tics
	xor	dx,dx
	call	near ptr N_LXMUL@
	mov	word ptr [bp-12],ax
	mov	word ptr [bp-10],dx
   ;	
   ;	
   ;		deltax = FixedByFrac(speed,costable[ob->angle]);
   ;	
	mov	ax,word ptr [si+40]
	shl	ax,1
	shl	ax,1
	les	bx,dword ptr DGROUP:_costable
	add	bx,ax
	push	word ptr es:[bx+2]
	push	word ptr es:[bx]
	push	word ptr [bp-10]
	push	word ptr [bp-12]
	call	near ptr _FixedByFrac
	add	sp,8
	mov	word ptr [bp-4],ax
	mov	word ptr [bp-2],dx
   ;	
   ;		deltay = -FixedByFrac(speed,sintable[ob->angle]);
   ;	
	mov	bx,word ptr [si+40]
	shl	bx,1
	shl	bx,1
	mov	ax,seg _sintable
	mov	es,ax
	push	word ptr es:_sintable[bx+2]
	push	word ptr es:_sintable[bx]
	push	word ptr [bp-10]
	push	word ptr [bp-12]
	call	near ptr _FixedByFrac
	add	sp,8
	neg	dx
	neg	ax
	sbb	dx,0
	mov	word ptr [bp-8],ax
	mov	word ptr [bp-6],dx
   ;	
   ;	
   ;		if (deltax>0x10000l)
   ;	
	cmp	word ptr [bp-2],1
	jl	short @3@122
	jg	short @3@98
	cmp	word ptr [bp-4],0
	jbe	short @3@122
@3@98:
   ;	
   ;			deltax = 0x10000l;
   ;	
	mov	word ptr [bp-4],0
	mov	word ptr [bp-2],1
@3@122:
   ;	
   ;		if (deltay>0x10000l)
   ;	
	cmp	word ptr [bp-6],1
	jl	short @3@218
	jg	short @3@194
	cmp	word ptr [bp-8],0
	jbe	short @3@218
@3@194:
   ;	
   ;			deltay = 0x10000l;
   ;	
	mov	word ptr [bp-8],0
	mov	word ptr [bp-6],1
@3@218:
   ;	
   ;	
   ;		ob->x += deltax;
   ;	
	mov	ax,word ptr [bp-2]
	mov	dx,word ptr [bp-4]
	add	word ptr [si+15],dx
	adc	word ptr [si+17],ax
   ;	
   ;		ob->y += deltay;
   ;	
	mov	ax,word ptr [bp-6]
	mov	dx,word ptr [bp-8]
	add	word ptr [si+19],dx
	adc	word ptr [si+21],ax
   ;	
   ;	
   ;		deltax = LABS(ob->x - player->x);
   ;	
	mov	ax,word ptr [si+17]
	mov	dx,word ptr [si+15]
	mov	bx,word ptr DGROUP:_player
	sub	dx,word ptr [bx+15]
	sbb	ax,word ptr [bx+17]
	or	ax,ax
	jl	short @3@314
	jg	short @3@290
	or	dx,dx
	jbe	short @3@314
@3@290:
	mov	dx,word ptr [si+17]
	mov	ax,word ptr [si+15]
	mov	bx,word ptr DGROUP:_player
	sub	ax,word ptr [bx+15]
	sbb	dx,word ptr [bx+17]
	jmp	short @3@338
@3@314:
	mov	dx,word ptr [si+17]
	mov	ax,word ptr [si+15]
	mov	bx,word ptr DGROUP:_player
	sub	ax,word ptr [bx+15]
	sbb	dx,word ptr [bx+17]
	neg	dx
	neg	ax
	sbb	dx,0
@3@338:
	mov	word ptr [bp-4],ax
	mov	word ptr [bp-2],dx
   ;	
   ;		deltay = LABS(ob->y - player->y);
   ;	
	mov	ax,word ptr [si+21]
	mov	dx,word ptr [si+19]
	mov	bx,word ptr DGROUP:_player
	sub	dx,word ptr [bx+19]
	sbb	ax,word ptr [bx+21]
	or	ax,ax
	jl	short @3@434
	jg	short @3@410
	or	dx,dx
	jbe	short @3@434
@3@410:
	mov	dx,word ptr [si+21]
	mov	ax,word ptr [si+19]
	mov	bx,word ptr DGROUP:_player
	sub	ax,word ptr [bx+19]
	sbb	dx,word ptr [bx+21]
	jmp	short @3@458
@3@434:
	mov	dx,word ptr [si+21]
	mov	ax,word ptr [si+19]
	mov	bx,word ptr DGROUP:_player
	sub	ax,word ptr [bx+19]
	sbb	dx,word ptr [bx+21]
	neg	dx
	neg	ax
	sbb	dx,0
@3@458:
	mov	word ptr [bp-8],ax
	mov	word ptr [bp-6],dx
   ;	
   ;	
   ;		if (!ProjectileTryMove (ob))
   ;	
	push	si
	call	near ptr _ProjectileTryMove
	pop	cx
	or	ax,ax
	jne	short @3@578
   ;	
   ;		{
   ;			if (ob->obclass == rocketobj)
   ;	
	cmp	word ptr [si+4],20
	jne	short @3@530
   ;	
   ;			{
   ;				PlaySoundLocActor(MISSILEHITSND,ob);
   ;	
	push	word ptr [si+21]
	push	word ptr [si+19]
	push	word ptr [si+17]
	push	word ptr [si+15]
	mov	ax,86
	push	ax
	call	near ptr _PlaySoundLocGlobal
	add	sp,10
   ;	
   ;				ob->state = &s_boom1;
   ;	
	mov	word ptr [si+6],offset DGROUP:_s_boom1
   ;	
   ;			}
   ;	
	jmp	short @3@554
@3@530:
   ;	
   ;	#ifdef SPEAR
   ;			else if (ob->obclass == hrocketobj)
   ;			{
   ;				PlaySoundLocActor(MISSILEHITSND,ob);
   ;				ob->state = &s_hboom1;
   ;			}
   ;	#endif
   ;			else
   ;				ob->state = NULL;		// mark for removal
   ;	
	mov	word ptr [si+6],0
@3@554:
   ;	
   ;	
   ;			return;
   ;	
	jmp	@3@986
@3@578:
   ;	
   ;		}
   ;	
   ;		if (deltax < PROJECTILESIZE && deltay < PROJECTILESIZE)
   ;	
	cmp	word ptr [bp-2],0
	jg	short @3@962
	jl	short @3@650
	cmp	word ptr [bp-4],49152
	jae	short @3@962
@3@650:
	cmp	word ptr [bp-6],0
	jg	short @3@962
	jl	short @3@722
	cmp	word ptr [bp-8],49152
	jae	short @3@962
@3@722:
   ;	
   ;		{	// hit the player
   ;			switch (ob->obclass)
   ;	
	mov	ax,word ptr [si+4]
	mov	word ptr [bp-14],ax
	mov	cx,5
	mov	bx,offset @3@C2808
@3@770:
	mov	ax,word ptr cs:[bx]
	cmp	ax,word ptr [bp-14]
	je	short @3@842
	inc	bx
	inc	bx
	loop	short @3@770
	jmp	short @3@938
@3@842:
	jmp	word ptr cs:[bx+10]
@3@866:
   ;	
   ;			{
   ;			case needleobj:
   ;				damage = (US_RndT() >>3) + 20;
   ;	
	call	near ptr _US_RndT
	sar	ax,1
	sar	ax,1
	sar	ax,1
	add	ax,20
	mov	di,ax
   ;	
   ;				break;
   ;	
	jmp	short @3@938
@3@890:
   ;	
   ;			case rocketobj:
   ;			case hrocketobj:
   ;			case sparkobj:
   ;				damage = (US_RndT() >>3) + 30;
   ;	
	call	near ptr _US_RndT
	sar	ax,1
	sar	ax,1
	sar	ax,1
	add	ax,30
	mov	di,ax
   ;	
   ;				break;
   ;	
	jmp	short @3@938
@3@914:
   ;	
   ;			case fireobj:
   ;				damage = (US_RndT() >>3);
   ;	
	call	near ptr _US_RndT
	sar	ax,1
	sar	ax,1
	sar	ax,1
	mov	di,ax
   ;	
