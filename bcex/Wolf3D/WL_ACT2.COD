	call	near ptr _SelectDodgeDir
	pop	cx
	jmp	short @18@290
@18@266:
   ;	
   ;		  25,	// ghosts
   ;		  25,	// ghosts
   ;	
	push	si
	call	near ptr _SelectChaseDir
	pop	cx
@18@290:
   ;	
   ;		  25,	// ghosts
   ;	
	cmp	word ptr [si+13],8
	jne	short @18@338
   ;	
   ;		  25,	// ghosts
   ;	
	jmp	@18@794
@18@338:
   ;	
   ;	
   ;		  1050,	// Gretel
