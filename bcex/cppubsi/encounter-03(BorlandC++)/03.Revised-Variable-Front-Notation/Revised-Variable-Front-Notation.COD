	ifndef	??version
?debug	macro
	endm
$comm	macro	name,dist,size,count
	comm	dist name:BYTE:count*size
	endm
	else
$comm	macro	name,dist,size,count
	comm	dist name[size]:BYTE:count
	endm
	endif
	?debug	S "c:\src.cpp"
	?debug	C E9107DBB840A633A5C7372632E637070
	?debug	C E95337528112443A5C494E434C5544455C737464696F2E68
	?debug	C E95337528112443A5C494E434C5544455C636F6E696F2E68
	?debug	C E95337528115443A5C494E434C5544455C696F73747265616D2E68
	?debug	C E95337528110443A5C494E434C5544455C6D656D2E68
_TEXT	segment byte public 'CODE'
_TEXT	ends
DGROUP	group	_DATA,_BSS
	assume	cs:_TEXT,ds:DGROUP
_DATA	segment word public 'DATA'
d@	label	byte
d@w	label	word
_DATA	ends
_BSS	segment word public 'BSS'
b@	label	byte
b@w	label	word
_BSS	ends
_TEXT	segment byte public 'CODE'
   ;	
   ;	main()
   ;	
	assume	cs:_TEXT
_main	proc	near
	push	bp
	mov	bp,sp
	push	si
	push	di
   ;	
   ;	{
   ;	   int a = 10, b = 5;
   ;	
	mov	di,10
	mov	si,5
   ;	
   ;	   clrscr();
   ;	
	call	near ptr _clrscr
   ;	
   ;	   printf("Nilai A = %d",a);
   ;	
	push	di
	mov	ax,offset DGROUP:s@
	push	ax
	call	near ptr _printf
	pop	cx
	pop	cx
   ;	
   ;	   printf("\nNilai ++A = %d",a++);
   ;	
	mov	ax,di
	inc	di
	push	ax
	mov	ax,offset DGROUP:s@+13
	push	ax
	call	near ptr _printf
	pop	cx
	pop	cx
   ;	
   ;	   printf("\nNilai B ==%d",b);
   ;	
	push	si
	mov	ax,offset DGROUP:s@+29
	push	ax
	call	near ptr _printf
	pop	cx
	pop	cx
   ;	
   ;	   printf("\nNilai --B = %d", b--);
   ;	
	mov	ax,si
	dec	si
	push	ax
	mov	ax,offset DGROUP:s@+43
	push	ax
	call	near ptr _printf
	pop	cx
	pop	cx
   ;	
   ;	   printf("\nNilai B = %d", b);
   ;	
	push	si
	mov	ax,offset DGROUP:s@+59
	push	ax
	call	near ptr _printf
	pop	cx
	pop	cx
   ;	
   ;	   getch();
   ;	
	call	near ptr _getch
   ;	
   ;	}
   ;	
	pop	di
	pop	si
	pop	bp
	ret	
_main	endp
	?debug	C E9
_TEXT	ends
_DATA	segment word public 'DATA'
s@	label	byte
	db	'Nilai A = %d'
	db	0
	db	10
	db	'Nilai ++A = %d'
	db	0
	db	10
	db	'Nilai B ==%d'
	db	0
	db	10
	db	'Nilai --B = %d'
	db	0
	db	10
	db	'Nilai B = %d'
	db	0
_DATA	ends
_TEXT	segment byte public 'CODE'
_TEXT	ends
_s@	equ	s@
	$comm	@ios@basefield,near,4,1
	$comm	@ios@adjustfield,near,4,1
	$comm	@ios@floatfield,near,4,1
	$comm	@ios@stdioflush,near,2,1
	$comm	@ios@nextbit,near,4,1
	$comm	@ios@usercount,near,2,1
	public	_main
	extrn	_clrscr:near
	extrn	_printf:near
	extrn	_getch:near
	end
