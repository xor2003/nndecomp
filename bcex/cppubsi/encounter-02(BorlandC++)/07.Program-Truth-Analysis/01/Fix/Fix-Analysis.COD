	ifndef	??version
?debug	macro
	endm
$comm	macro	name,dist,size,count
	comm	dist name:BYTE:count*size
	endm
	else
$comm	macro	name,dist,size,count
	comm	dist name[size]:BYTE:count
	endm
	endif
	?debug	S "c:\src.cpp"
	?debug	C E90F7DBB840A633A5C7372632E637070
	?debug	C E95337528112443A5C494E434C5544455C737464696F2E68
	?debug	C E95337528112443A5C494E434C5544455C636F6E696F2E68
_TEXT	segment byte public 'CODE'
_TEXT	ends
DGROUP	group	_DATA,_BSS
	assume	cs:_TEXT,ds:DGROUP
_DATA	segment word public 'DATA'
d@	label	byte
d@w	label	word
_DATA	ends
_BSS	segment word public 'BSS'
b@	label	byte
b@w	label	word
_BSS	ends
_TEXT	segment byte public 'CODE'
   ;	
   ;	main()
   ;	
	assume	cs:_TEXT
_main	proc	near
	push	bp
	mov	bp,sp
	sub	sp,10
	push	si
   ;	
   ;	{
   ;	int jumlah;
   ;	float harga_per_satuan, harga_total;
   ;	jumlah=50;
   ;	
	mov	si,50
   ;	
   ;	harga_per_satuan=15.7;
   ;	
	FLD	dword ptr DGROUP:s@
	FSTP	dword ptr [bp-4]
   ;	
   ;	harga_total= jumlah * harga_per_satuan;
   ;	
	FWAIT	
	mov	word ptr [bp-10],si
	FILD	word ptr [bp-10]
	FMUL	dword ptr [bp-4]
	FSTP	dword ptr [bp-8]
   ;	
   ;	printf("Harga Total= %f \n", harga_total);
   ;	
	FLD	dword ptr [bp-8]
	add	sp,65528
	FSTP	qword ptr [bp-20]
	mov	ax,offset DGROUP:s@+4
	push	ax
	FWAIT	
	call	near ptr _printf
	add	sp,10
   ;	
   ;	getch( );
   ;	
	call	near ptr _getch
   ;	
   ;	}
   ;	
	pop	si
	mov	sp,bp
	pop	bp
	ret	
_main	endp
	?debug	C E9
_TEXT	ends
_DATA	segment word public 'DATA'
s@	label	byte
	db	'33{AHarga Total= %f '
	db	10
	db	0
_DATA	ends
_TEXT	segment byte public 'CODE'
_TEXT	ends
_s@	equ	s@
	public	_main
	extrn	_printf:near
	extrn	_getch:near
	end
