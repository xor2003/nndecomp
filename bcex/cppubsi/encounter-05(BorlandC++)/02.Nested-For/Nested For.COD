	ifndef	??version
?debug	macro
	endm
$comm	macro	name,dist,size,count
	comm	dist name:BYTE:count*size
	endm
	else
$comm	macro	name,dist,size,count
	comm	dist name[size]:BYTE:count
	endm
	endif
	?debug	S "c:\src.cpp"
	?debug	C E9107DBB840A633A5C7372632E637070
	?debug	C E95337528112443A5C494E434C5544455C737464696F2E68
	?debug	C E95337528112443A5C494E434C5544455C636F6E696F2E68
_TEXT	segment byte public 'CODE'
_TEXT	ends
DGROUP	group	_DATA,_BSS
	assume	cs:_TEXT,ds:DGROUP
_DATA	segment word public 'DATA'
d@	label	byte
d@w	label	word
_DATA	ends
_BSS	segment word public 'BSS'
b@	label	byte
b@w	label	word
_BSS	ends
_TEXT	segment byte public 'CODE'
   ;	
   ;	main()
   ;	
	assume	cs:_TEXT
_main	proc	near
	push	bp
	mov	bp,sp
	push	si
	push	di
   ;	
   ;	{
   ;	int a, b;
   ;	clrscr();
   ;	
	call	near ptr _clrscr
   ;	
   ;	for(a = 1; a <= 5; a++)
   ;	
	mov	di,1
	jmp	short @1@170
@1@50:
   ;	
   ;	{
   ;	printf ("\n");
   ;	
	mov	ax,offset DGROUP:s@
	push	ax
	call	near ptr _printf
	pop	cx
   ;	
   ;	for (b = a; b <= 5; b++ )
   ;	
	mov	si,di
	jmp	short @1@122
@1@74:
   ;	
   ;	printf("%d",a);
   ;	
	push	di
	mov	ax,offset DGROUP:s@+2
	push	ax
	call	near ptr _printf
	pop	cx
	pop	cx
	inc	si
@1@122:
	cmp	si,5
	jle	short @1@74
	inc	di
@1@170:
	cmp	di,5
	jle	short @1@50
   ;	
   ;	}
   ;	getch();
   ;	
	call	near ptr _getch
   ;	
   ;	}
   ;	
	pop	di
	pop	si
	pop	bp
	ret	
_main	endp
	?debug	C E9
_TEXT	ends
_DATA	segment word public 'DATA'
s@	label	byte
	db	10
	db	0
	db	'%d'
	db	0
_DATA	ends
_TEXT	segment byte public 'CODE'
_TEXT	ends
_s@	equ	s@
	public	_main
	extrn	_clrscr:near
	extrn	_printf:near
	extrn	_getch:near
	end
