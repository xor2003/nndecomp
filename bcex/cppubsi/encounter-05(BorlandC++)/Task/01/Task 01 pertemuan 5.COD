	mov	si,2
	jmp	short @1@170
@1@50:
   ;	
   ;	{
   ;	if(a<20)
   ;	
	cmp	si,20
	jge	short @1@98
   ;	
   ;	cout<<a<<" + ";
   ;	
	mov	ax,si
	cwd	
	push	dx
	push	ax
	mov	ax,offset DGROUP:_cout
	push	ax
	call	near ptr @ostream@$blsh$ql
	add	sp,6
	mov	word ptr [bp-2],ax
	xor	ax,ax
	push	ax
	mov	ax,offset DGROUP:s@
	push	ax
	push	word ptr [bp-2]
	call	near ptr @ostream@outstr$qpxzct1
	add	sp,6
	jmp	short @1@122
@1@98:
   ;	
   ;	else
   ;	cout<<a;
   ;	
	mov	ax,si
	cwd	
	push	dx
	push	ax
	mov	ax,offset DGROUP:_cout
	push	ax
	call	near ptr @ostream@$blsh$ql
	add	sp,6
@1@122:
   ;	
   ;	b=b+a;
   ;	
	mov	ax,di
	add	ax,si
	mov	di,ax
	inc	si
	inc	si
@1@170:
	cmp	si,20
	jle	short @1@50
   ;	
   ;	}
   ;	cout<<" = "<<b;
   ;	
	mov	ax,di
	cwd	
	push	dx
	push	ax
	xor	ax,ax
	push	ax
	mov	ax,offset DGROUP:s@+4
	push	ax
	mov	ax,offset DGROUP:_cout
	push	ax
	call	near ptr @ostream@outstr$qpxzct1
	add	sp,6
	mov	ax,offset DGROUP:_cout
	push	ax
	call	near ptr @ostream@$blsh$ql
	add	sp,6
