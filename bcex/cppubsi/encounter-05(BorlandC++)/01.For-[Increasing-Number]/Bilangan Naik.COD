	mov	si,1
	jmp	short @1@98
@1@50:
   ;	
   ;	cout<<a;
   ;	
	mov	ax,si
	cwd	
	push	dx
	push	ax
	mov	ax,offset DGROUP:_cout
	push	ax
	call	near ptr @ostream@$blsh$ql
	add	sp,6
	inc	si
@1@98:
	cmp	si,10
	jle	short @1@50
   ;	
   ;	getch();
   ;	
	call	near ptr _getch
   ;	
   ;	}
   ;	
	pop	si
	pop	bp
	ret	
_main	endp
