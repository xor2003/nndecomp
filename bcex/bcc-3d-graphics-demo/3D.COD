_TEXT	segment byte public 'CODE'
   ;	
   ;	void apply_perspective(POINT *point, double distance)
   ;	
	assume	cs:_TEXT
_apply_perspective	proc	near
	push	bp
	mov	bp,sp
	sub	sp,8
	push	si
	mov	si,word ptr [bp+4]
   ;	
   ;	{
   ;	    double Ze;
   ;	
   ;	    Ze = 1000-(point->z);
   ;	
	FLD	qword ptr [si+16]
	FSUBR	dword ptr DGROUP:s@
	FSTP	qword ptr [bp-8]
   ;	
   ;	
   ;	    point->x = distance*point->x / Ze;
   ;	
	FLD	qword ptr [si]
	FMUL	qword ptr [bp+6]
	FDIV	qword ptr [bp-8]
	FSTP	qword ptr [si]
   ;	
   ;	    point->y = distance*point->y / Ze;
   ;	
	FLD	qword ptr [si+8]
	FMUL	qword ptr [bp+6]
	FDIV	qword ptr [bp-8]
	FSTP	qword ptr [si+8]
	FWAIT	
   ;	
   ;	}
   ;	
	pop	si
	mov	sp,bp
	pop	bp
	ret	
_apply_perspective	endp
   ;	
   ;	void init_light_source(void)
   ;	
	assume	cs:_TEXT
_init_light_source	proc	near
	push	bp
	mov	bp,sp
	sub	sp,8
   ;	
   ;	{
   ;	    double l;
   ;	
   ;	    l = sqrt(light_src.x*light_src.x +
   ;	
   ;	
   ;	             light_src.y*light_src.y +
   ;	             light_src.z*light_src.z);
   ;	
	FLD	qword ptr DGROUP:_light_src
	FMUL	qword ptr DGROUP:_light_src
	FLD	qword ptr DGROUP:_light_src+8
	FMUL	qword ptr DGROUP:_light_src+8
	FADD	
	FLD	qword ptr DGROUP:_light_src+16
	FMUL	qword ptr DGROUP:_light_src+16
	FADD	
	add	sp,65528
	FSTP	qword ptr [bp-16]
	FWAIT	
	call	near ptr _sqrt
	add	sp,8
	FSTP	qword ptr [bp-8]
   ;	
   ;	
   ;	    light_src.x /= l;
   ;	
	FLD	qword ptr [bp-8]
	FDIVR	qword ptr DGROUP:_light_src
	FSTP	qword ptr DGROUP:_light_src
   ;	
   ;	    light_src.y /= l;
   ;	
	FLD	qword ptr [bp-8]
	FDIVR	qword ptr DGROUP:_light_src+8
	FSTP	qword ptr DGROUP:_light_src+8
   ;	
   ;	    light_src.z /= l;
   ;	
	FLD	qword ptr [bp-8]
	FDIVR	qword ptr DGROUP:_light_src+16
	FSTP	qword ptr DGROUP:_light_src+16
   ;	
   ;	}
   ;	
	mov	sp,bp
	pop	bp
	ret	
_init_light_source	endp
   ;	
   ;	int is_visible(MODEL *model, BYTE face)
   ;	
	assume	cs:_TEXT
_is_visible	proc	near
	push	bp
	mov	bp,sp
	sub	sp,34
	push	si
	push	di
	mov	di,word ptr [bp+4]
   ;	
   ;	{
   ;	    double Xa,Ya,Xb,Yb;
   ;	    BYTE   *p;
   ;	
   ;	    /* vector from vertex 0 to vertex 1 */
   ;	    p  = &model->face[face].point[0];
   ;	
	mov	ax,word ptr [bp+6]
	mov	dx,10
	imul	dx
	mov	dx,di
	add	dx,ax
	add	dx,198
	mov	si,dx
   ;	
   ;	    Xa = model->world[*p].x - model->world[*(p+1)].x;
   ;	
	mov	ax,word ptr [si]
	mov	dx,24
	imul	dx
	mov	bx,ax
	FLD	qword ptr [bx+di+4]
	mov	ax,word ptr [si+2]
	mov	dx,24
	imul	dx
	mov	bx,ax
	FSUB	qword ptr [bx+di+4]
	FSTP	qword ptr [bp-8]
   ;	
   ;	    Ya = model->world[*p].y - model->world[*(p+1)].y;
   ;	
	FWAIT	
	mov	ax,word ptr [si]
	mov	dx,24
	imul	dx
	mov	bx,ax
	FLD	qword ptr [bx+di+12]
	mov	ax,word ptr [si+2]
	mov	dx,24
	imul	dx
	mov	bx,ax
	FSUB	qword ptr [bx+di+12]
	FSTP	qword ptr [bp-16]
   ;	
   ;	
   ;	    /* vector from vertex 2 to vertex 1 */
   ;	    p++;
   ;	
	inc	si
	inc	si
   ;	
   ;	    Xb = model->world[*(p+1)].x - model->world[*p].x;
   ;	
	FWAIT	
	mov	ax,word ptr [si+2]
	mov	dx,24
	imul	dx
	mov	bx,ax
	FLD	qword ptr [bx+di+4]
	mov	ax,word ptr [si]
	mov	dx,24
	imul	dx
	mov	bx,ax
	FSUB	qword ptr [bx+di+4]
	FSTP	qword ptr [bp-24]
   ;	
   ;	    Yb = model->world[*(p+1)].y - model->world[*p].y;
   ;	
	FWAIT	
	mov	ax,word ptr [si+2]
	mov	dx,24
	imul	dx
	mov	bx,ax
	FLD	qword ptr [bx+di+12]
	mov	ax,word ptr [si]
	mov	dx,24
	imul	dx
	mov	bx,ax
	FSUB	qword ptr [bx+di+12]
	FSTP	qword ptr [bp-32]
   ;	
   ;	
   ;	    /* face visible if result > 0 */
   ;	    return ((Xa*Yb - Ya*Xb) >= 0);
   ;	
	FLD	qword ptr [bp-8]
	FMUL	qword ptr [bp-32]
	FLD	qword ptr [bp-16]
	FMUL	qword ptr [bp-24]
	FSUB	
	FLDZ	
	FCOMPP
	FSTSW	word ptr [bp-34]
	FWAIT	
	mov	ax,word ptr [bp-34]
	sahf	
	ja	short @3@74
	mov	ax,1
	jmp	short @3@98
@3@74:
	xor	ax,ax
@3@98:
	jmp	short @3@122
@3@122:
   ;	
   ;	}
   ;	
	pop	di
	pop	si
	mov	sp,bp
	pop	bp
	ret	
_is_visible	endp
   ;	
   ;	double compute_illumination(MODEL *model, BYTE face)
   ;	
	assume	cs:_TEXT
_compute_illumination	proc	near
	push	bp
	mov	bp,sp
	sub	sp,82
	push	si
	push	di
	mov	di,word ptr [bp+4]
   ;	
   ;	{
   ;	    double n,Xa,Xb,Za,Zb,Ya,Yb;
   ;	    POINT  nh;
   ;	    BYTE   *p;
   ;	
   ;	    /* vector from vertex 0 to vertex 1 */
   ;	    p  = &model->face[face].point[0];
   ;	
	mov	ax,word ptr [bp+6]
	mov	dx,10
	imul	dx
	mov	dx,di
	add	dx,ax
	add	dx,198
	mov	si,dx
   ;	
   ;	    Xa = model->world[*p].x - model->world[*(p+1)].x;
   ;	
	mov	ax,word ptr [si]
	mov	dx,24
	imul	dx
	mov	bx,ax
	FLD	qword ptr [bx+di+4]
	mov	ax,word ptr [si+2]
	mov	dx,24
	imul	dx
	mov	bx,ax
	FSUB	qword ptr [bx+di+4]
	FSTP	qword ptr [bp-16]
   ;	
   ;	    Ya = model->world[*p].y - model->world[*(p+1)].y;
   ;	
	FWAIT	
	mov	ax,word ptr [si]
	mov	dx,24
	imul	dx
	mov	bx,ax
	FLD	qword ptr [bx+di+12]
	mov	ax,word ptr [si+2]
	mov	dx,24
	imul	dx
	mov	bx,ax
	FSUB	qword ptr [bx+di+12]
	FSTP	qword ptr [bp-48]
   ;	
   ;	    Za = model->world[*p].z - model->world[*(p+1)].z;
   ;	
	FWAIT	
	mov	ax,word ptr [si]
	mov	dx,24
	imul	dx
	mov	bx,ax
	FLD	qword ptr [bx+di+20]
	mov	ax,word ptr [si+2]
	mov	dx,24
	imul	dx
	mov	bx,ax
	FSUB	qword ptr [bx+di+20]
	FSTP	qword ptr [bp-32]
   ;	
   ;	
   ;	    /* vector from vertex 1 to vertex 2 */
   ;	    p++;
   ;	
	inc	si
	inc	si
   ;	
   ;	    Xb = model->world[*(p+1)].x - model->world[*p].x;
   ;	
	FWAIT	
	mov	ax,word ptr [si+2]
	mov	dx,24
	imul	dx
	mov	bx,ax
	FLD	qword ptr [bx+di+4]
	mov	ax,word ptr [si]
	mov	dx,24
	imul	dx
	mov	bx,ax
	FSUB	qword ptr [bx+di+4]
	FSTP	qword ptr [bp-24]
   ;	
   ;	    Yb = model->world[*(p+1)].y - model->world[*p].y;
   ;	
	FWAIT	
	mov	ax,word ptr [si+2]
	mov	dx,24
	imul	dx
	mov	bx,ax
	FLD	qword ptr [bx+di+12]
	mov	ax,word ptr [si]
	mov	dx,24
	imul	dx
	mov	bx,ax
	FSUB	qword ptr [bx+di+12]
	FSTP	qword ptr [bp-56]
   ;	
   ;	    Zb = model->world[*(p+1)].z - model->world[*p].z;
   ;	
	FWAIT	
	mov	ax,word ptr [si+2]
	mov	dx,24
	imul	dx
	mov	bx,ax
	FLD	qword ptr [bx+di+20]
	mov	ax,word ptr [si]
	mov	dx,24
	imul	dx
	mov	bx,ax
	FSUB	qword ptr [bx+di+20]
	FSTP	qword ptr [bp-40]
   ;	
   ;	
   ;	    /* calculate surface perpendicular vector */
   ;	    nh.x = Ya*Zb - Za*Yb;
   ;	
	FLD	qword ptr [bp-48]
	FMUL	qword ptr [bp-40]
	FLD	qword ptr [bp-32]
	FMUL	qword ptr [bp-56]
	FSUB	
	FSTP	qword ptr [bp-82]
   ;	
   ;	    nh.y = Xa*Zb - Za*Xb;
   ;	
	FLD	qword ptr [bp-16]
	FMUL	qword ptr [bp-40]
	FLD	qword ptr [bp-32]
	FMUL	qword ptr [bp-24]
	FSUB	
	FSTP	qword ptr [bp-74]
   ;	
   ;	    nh.z = Xa*Yb - Ya*Xb;
   ;	
	FLD	qword ptr [bp-16]
	FMUL	qword ptr [bp-56]
	FLD	qword ptr [bp-48]
	FMUL	qword ptr [bp-24]
	FSUB	
	FSTP	qword ptr [bp-66]
   ;	
   ;	
   ;	    n = sqrt(nh.x*nh.x + nh.y*nh.y + nh.z*nh.z);
   ;	
	FLD	qword ptr [bp-82]
	FMUL	qword ptr [bp-82]
	FLD	qword ptr [bp-74]
	FMUL	qword ptr [bp-74]
	FADD	
	FLD	qword ptr [bp-66]
	FMUL	qword ptr [bp-66]
	FADD	
	add	sp,65528
	FSTP	qword ptr [bp-94]
	FWAIT	
	call	near ptr _sqrt
	add	sp,8
	FSTP	qword ptr [bp-8]
   ;	
   ;	
   ;	    nh.x /= n;
   ;	
	FLD	qword ptr [bp-8]
	FDIVR	qword ptr [bp-82]
	FSTP	qword ptr [bp-82]
   ;	
   ;	    nh.y /= n;
   ;	
	FLD	qword ptr [bp-8]
	FDIVR	qword ptr [bp-74]
	FSTP	qword ptr [bp-74]
   ;	
   ;	    nh.z /= n;
   ;	
	FLD	qword ptr [bp-8]
	FDIVR	qword ptr [bp-66]
	FSTP	qword ptr [bp-66]
   ;	
   ;	
   ;	    n = nh.x*light_src.x + nh.y*light_src.y + nh.z*light_src.z;
   ;	
	FLD	qword ptr [bp-82]
	FMUL	qword ptr DGROUP:_light_src
	FLD	qword ptr [bp-74]
	FMUL	qword ptr DGROUP:_light_src+8
	FADD	
	FLD	qword ptr [bp-66]
	FMUL	qword ptr DGROUP:_light_src+16
	FADD	
	FSTP	qword ptr [bp-8]
   ;	
   ;	
   ;	    if (n<0)
   ;	
	FLD	qword ptr [bp-8]
	FLDZ	
	FCOMPP
	FSTSW	word ptr [bp-58]
	FWAIT	
	mov	ax,word ptr [bp-58]
	sahf	
	jbe	short @4@74
   ;	
   ;	        n = 0;
   ;	
	FLDZ	
	FSTP	qword ptr [bp-8]
	FWAIT	
@4@74:
   ;	
   ;	
   ;	    return (n);
   ;	
	FLD	qword ptr [bp-8]
	jmp	short @4@98
@4@98:
   ;	
   ;	}
   ;	
	pop	di
	pop	si
	mov	sp,bp
	pop	bp
	ret	
_compute_illumination	endp
   ;	
   ;	void draw_model(MODEL *model, int x, int y)
   ;	
	assume	cs:_TEXT
_draw_model	proc	near
	push	bp
	mov	bp,sp
	sub	sp,32
	push	si
	push	di
   ;	
   ;	{
   ;	    register BYTE face;
   ;	    FACET *p;
   ;	//  POINT temp_point;
   ;	    int   polypoints[10];
   ;	    int   i,j;
   ;	    double illumination;
   ;	
   ;	    for (face = 0; face < model->faces; face++)
   ;	
	xor	si,si
	jmp	@5@218
@5@50:
   ;	
   ;	    {
   ;	        if (is_visible(model, face))
   ;	
	push	si
	push	word ptr [bp+4]
	call	near ptr _is_visible
	pop	cx
	pop	cx
	or	ax,ax
	jne	@@0
	jmp	@5@194
@@0:
   ;	
   ;	        {
   ;	            p = &model->face[face];
   ;	
	mov	ax,si
	mov	dx,10
	imul	dx
	mov	dx,word ptr [bp+4]
	add	dx,ax
	add	dx,196
	mov	word ptr [bp-2],dx
   ;	
   ;	            for (i=j=0; i < model->face[face].corners*2; i+=2,j++)
   ;	
	xor	ax,ax
	mov	word ptr [bp-4],ax
	mov	di,ax
	jmp	short @5@146
@5@98:
   ;	
   ;	            {
   ;					/* calculate perspective */
   ;	//              temp_point.x = model->world[p->point[j]].x;
   ;	//              temp_point.y = model->world[p->point[j]].y;
   ;	//              temp_point.z = model->world[p->point[j]].z;
   ;	//              apply_perspective(&temp_point, -500);
   ;	//              polypoints[i]   = (int) temp_point.x+x;
   ;	//              polypoints[i+1] = (int) temp_point.y+y;
   ;	
   ;					/* add polygon points */
   ;	                polypoints[i]   = (int) model->world[p->point[j]].x+x;
   ;	
	mov	bx,di
	shl	bx,1
	lea	ax,word ptr [bp-32]
	add	bx,ax
	mov	ax,word ptr [bp-4]
	shl	ax,1
	push	bx
	mov	bx,word ptr [bp-2]
	add	bx,ax
	mov	ax,word ptr [bx+2]
	mov	dx,24
	imul	dx
	mov	bx,word ptr [bp+4]
	add	bx,ax
	FLD	qword ptr [bx+4]
	call	near ptr N_FTOL@
	add	ax,word ptr [bp+6]
	pop	bx
	mov	word ptr [bx],ax
   ;	
   ;	                polypoints[i+1] = (int) model->world[p->point[j]].y+y;
   ;	
	mov	bx,di
	shl	bx,1
	lea	ax,word ptr [bp-30]
	add	bx,ax
	mov	ax,word ptr [bp-4]
	shl	ax,1
	push	bx
	mov	bx,word ptr [bp-2]
	add	bx,ax
	mov	ax,word ptr [bx+2]
	mov	dx,24
	imul	dx
	mov	bx,word ptr [bp+4]
	add	bx,ax
	FLD	qword ptr [bx+12]
	call	near ptr N_FTOL@
	add	ax,word ptr [bp+8]
	pop	bx
	mov	word ptr [bx],ax
	inc	di
	inc	di
	inc	word ptr [bp-4]
@5@146:
	mov	ax,si
	mov	dx,10
	imul	dx
	mov	bx,word ptr [bp+4]
	add	bx,ax
	mov	ax,word ptr [bx+196]
	shl	ax,1
	cmp	ax,di
	jbe	@@1
	jmp	@5@98
@@1:
   ;	
   ;	            }
   ;	            /* close polygon */
   ;	            polypoints[i]   = polypoints[0];
   ;	
	mov	bx,di
	shl	bx,1
	lea	ax,word ptr [bp-32]
	add	bx,ax
	mov	ax,word ptr [bp-32]
	mov	word ptr [bx],ax
   ;	
   ;	            polypoints[i+1] = polypoints[1];
   ;	
	mov	bx,di
	shl	bx,1
	lea	ax,word ptr [bp-30]
	add	bx,ax
	mov	ax,word ptr [bp-30]
	mov	word ptr [bx],ax
   ;	
   ;	
   ;				/* illumination calculation determines colour index */
   ;	            illumination = compute_illumination(model, face);
   ;	
	push	si
	push	word ptr [bp+4]
	call	near ptr _compute_illumination
	pop	cx
	pop	cx
	FSTP	qword ptr [bp-12]
   ;	
   ;	
   ;				/* draw face using filled polygon */
   ;	            setfillstyle(SOLID_FILL, illumination*14.0+1);
   ;	
	FLD	qword ptr [bp-12]
	FMUL	dword ptr DGROUP:s@+4
	FLD1	
	FADD	
	call	near ptr N_FTOL@
	push	ax
	mov	ax,1
	push	ax
	call	far ptr _setfillstyle
	pop	cx
	pop	cx
   ;	
   ;	            setcolor(illumination);
   ;	
	FLD	qword ptr [bp-12]
	call	near ptr N_FTOL@
	push	ax
	call	far ptr _setcolor
	pop	cx
   ;	
   ;	            fillpoly(model->face[face].corners+1, polypoints);
   ;	
	push	ss
	lea	ax,word ptr [bp-32]
	push	ax
	mov	ax,si
	mov	dx,10
	imul	dx
	mov	bx,word ptr [bp+4]
	add	bx,ax
	mov	ax,word ptr [bx+196]
	inc	ax
	push	ax
	call	far ptr _fillpoly
	add	sp,6
@5@194:
	inc	si
@5@218:
	mov	bx,word ptr [bp+4]
	cmp	word ptr [bx+2],si
	jbe	@@2
	jmp	@5@50
@@2:
   ;	
   ;	        }
   ;	    }
   ;	}
   ;	
	pop	di
	pop	si
	mov	sp,bp
	pop	bp
	ret	
_draw_model	endp
   ;	
   ;	int main(void)
   ;	
	assume	cs:_TEXT
_main	proc	near
	push	bp
	mov	bp,sp
	sub	sp,38
	push	si
	push	di
   ;	
   ;	{
   ;	    int gdriver = VGA, gmode = VGAMED;
   ;	
	mov	word ptr [bp-2],9
	mov	word ptr [bp-4],1
   ;	
   ;	    int errorcode, page = 1;
   ;	
	mov	di,1
   ;	
   ;	    double cosine, sine, ncosine, nsine;
   ;	
   ;	    MODEL* model;
   ;	
   ;	    /* initialise graphics mode */
   ;	    initgraph(&gdriver, &gmode, "C:\\TOOLS\\BCC31\\BGI");
   ;	
	push	ds
	mov	ax,offset DGROUP:s@+8
	push	ax
	push	ss
	lea	ax,word ptr [bp-4]
	push	ax
	push	ss
	lea	ax,word ptr [bp-2]
	push	ax
	call	far ptr _initgraph
	add	sp,12
   ;	
   ;	    if ((errorcode = graphresult()) != grOk)
   ;	
	call	far ptr _graphresult
	mov	word ptr [bp-6],ax
	or	ax,ax
	je	short @6@74
   ;	
   ;	    {
   ;	        printf("Graphics error: %s\n", grapherrormsg(errorcode));
   ;	
	push	word ptr [bp-6]
	call	far ptr _grapherrormsg
	pop	cx
	push	ax
	mov	ax,offset DGROUP:s@+27
	push	ax
	call	near ptr _printf
	pop	cx
	pop	cx
   ;	
   ;	        exit(1);
   ;	
	mov	ax,1
	push	ax
	call	near ptr _exit
	pop	cx
@6@74:
   ;	
   ;	    }
   ;	
   ;	    /* create gradient palette entries */
   ;	    setrgbpalette(EGA_BLUE, 0, 0, 26);			// 5, 5, 5
   ;	
	mov	ax,26
	push	ax
	xor	ax,ax
	push	ax
	xor	ax,ax
	push	ax
	mov	ax,1
	push	ax
	call	far ptr _setrgbpalette
	add	sp,8
   ;	
   ;	    setrgbpalette(EGA_GREEN, 0, 0, 28);			// 8, 8, 8
   ;	
	mov	ax,28
	push	ax
	xor	ax,ax
	push	ax
	xor	ax,ax
	push	ax
	mov	ax,2
	push	ax
	call	far ptr _setrgbpalette
	add	sp,8
   ;	
   ;	    setrgbpalette(EGA_CYAN, 0, 0, 30);			// 11, 11, 11
   ;	
	mov	ax,30
	push	ax
	xor	ax,ax
	push	ax
	xor	ax,ax
	push	ax
	mov	ax,3
	push	ax
	call	far ptr _setrgbpalette
	add	sp,8
   ;	
   ;	    setrgbpalette(EGA_RED, 0, 0, 32);			// 14, 14, 14
   ;	
	mov	ax,32
	push	ax
	xor	ax,ax
	push	ax
	xor	ax,ax
	push	ax
	mov	ax,4
	push	ax
	call	far ptr _setrgbpalette
	add	sp,8
   ;	
   ;	    setrgbpalette(EGA_MAGENTA, 0, 0, 34);		// 17, 17, 17
   ;	
	mov	ax,34
	push	ax
	xor	ax,ax
	push	ax
	xor	ax,ax
	push	ax
	mov	ax,5
	push	ax
	call	far ptr _setrgbpalette
	add	sp,8
   ;	
   ;	    setrgbpalette(EGA_BROWN, 0, 0, 36);			// 20, 20, 20
   ;	
	mov	ax,36
	push	ax
	xor	ax,ax
	push	ax
	xor	ax,ax
	push	ax
	mov	ax,20
	push	ax
	call	far ptr _setrgbpalette
	add	sp,8
   ;	
   ;	    setrgbpalette(EGA_LIGHTGRAY, 0, 0, 38);		// 24, 24, 24
   ;	
	mov	ax,38
	push	ax
	xor	ax,ax
	push	ax
	xor	ax,ax
	push	ax
	mov	ax,7
	push	ax
	call	far ptr _setrgbpalette
	add	sp,8
   ;	
   ;	    setrgbpalette(EGA_DARKGRAY, 0, 0, 39);		// 28, 28, 28
   ;	
	mov	ax,39
	push	ax
	xor	ax,ax
	push	ax
	xor	ax,ax
	push	ax
	mov	ax,56
	push	ax
	call	far ptr _setrgbpalette
	add	sp,8
   ;	
   ;	    setrgbpalette(EGA_LIGHTBLUE, 0, 0, 40);		// 32, 32, 32
   ;	
	mov	ax,40
	push	ax
	xor	ax,ax
	push	ax
	xor	ax,ax
	push	ax
	mov	ax,57
	push	ax
	call	far ptr _setrgbpalette
	add	sp,8
   ;	
   ;	    setrgbpalette(EGA_LIGHTGREEN, 0, 0, 41);	// 36, 36, 36
   ;	
	mov	ax,41
	push	ax
	xor	ax,ax
	push	ax
	xor	ax,ax
	push	ax
	mov	ax,58
	push	ax
	call	far ptr _setrgbpalette
	add	sp,8
   ;	
   ;	    setrgbpalette(EGA_LIGHTCYAN, 0, 0, 42);		// 40, 40, 40
   ;	
	mov	ax,42
	push	ax
	xor	ax,ax
	push	ax
	xor	ax,ax
	push	ax
	mov	ax,59
	push	ax
	call	far ptr _setrgbpalette
	add	sp,8
   ;	
   ;	    setrgbpalette(EGA_LIGHTRED, 0, 0, 43);		// 45, 45, 45
   ;	
	mov	ax,43
	push	ax
	xor	ax,ax
	push	ax
	xor	ax,ax
	push	ax
	mov	ax,60
	push	ax
	call	far ptr _setrgbpalette
	add	sp,8
   ;	
   ;	    setrgbpalette(EGA_LIGHTMAGENTA, 0, 0, 44);	// 50, 50, 50
   ;	
	mov	ax,44
	push	ax
	xor	ax,ax
	push	ax
	xor	ax,ax
	push	ax
	mov	ax,61
	push	ax
	call	far ptr _setrgbpalette
	add	sp,8
   ;	
   ;	    setrgbpalette(EGA_YELLOW, 0, 0, 45);		// 56, 56, 56
   ;	
	mov	ax,45
	push	ax
	xor	ax,ax
	push	ax
	xor	ax,ax
	push	ax
	mov	ax,62
	push	ax
	call	far ptr _setrgbpalette
	add	sp,8
   ;	
   ;	    setrgbpalette(EGA_WHITE, 0, 0, 46);			// 63, 63, 63
   ;	
	mov	ax,46
	push	ax
	xor	ax,ax
	push	ax
	xor	ax,ax
	push	ax
	mov	ax,63
	push	ax
	call	far ptr _setrgbpalette
	add	sp,8
   ;	
   ;	
   ;	    /* initialise light source */
   ;	    init_light_source();
   ;	
	call	near ptr _init_light_source
   ;	
   ;	
   ;	    /* setup model */
   ;	    model = &wedge;
   ;	
	mov	si,offset DGROUP:_wedge
   ;	
   ;	    scale(model, 2);
   ;	
	FLD	dword ptr DGROUP:s@+47
	add	sp,65528
	FSTP	qword ptr [bp-50]
	push	si
	FWAIT	
	call	near ptr _scale
	add	sp,10
   ;	
   ;	
   ;	    /* start spinning model until key press */
   ;	    cosine = cos(0.1); sine = sin(0.1);
   ;	
	FLD	qword ptr DGROUP:s@+51
	add	sp,65528
	FSTP	qword ptr [bp-50]
	FWAIT	
	call	near ptr _cos
	add	sp,8
	FSTP	qword ptr [bp-14]
	FLD	qword ptr DGROUP:s@+51
	add	sp,65528
	FSTP	qword ptr [bp-50]
	FWAIT	
	call	near ptr _sin
	add	sp,8
	FSTP	qword ptr [bp-22]
   ;	
   ;	    ncosine = cos(-0.1); nsine = sin(-0.1);
   ;	
	FLD	qword ptr DGROUP:s@+59
	add	sp,65528
	FSTP	qword ptr [bp-50]
	FWAIT	
	call	near ptr _cos
	add	sp,8
	FSTP	qword ptr [bp-30]
	FLD	qword ptr DGROUP:s@+59
	add	sp,65528
	FSTP	qword ptr [bp-50]
	FWAIT	
	call	near ptr _sin
	add	sp,8
	FSTP	qword ptr [bp-38]
	FWAIT	
@6@98:
   ;	
   ;	    do
   ;	    {
   ;	       /* render new page */
   ;	       setactivepage(!page);
   ;	
	mov	ax,di
	neg	ax
	sbb	ax,ax
	inc	ax
	push	ax
	call	far ptr _setactivepage
	pop	cx
   ;	
   ;	       setfillstyle(SOLID_FILL, BLACK);
   ;	
	xor	ax,ax
	push	ax
	mov	ax,1
	push	ax
	call	far ptr _setfillstyle
	pop	cx
	pop	cx
   ;	
   ;	       bar(0, 0, getmaxx(), getmaxy());
   ;	
	call	far ptr _getmaxy
	push	ax
	call	far ptr _getmaxx
	push	ax
	xor	ax,ax
	push	ax
	xor	ax,ax
	push	ax
	call	far ptr _bar
	add	sp,8
   ;	
   ;	
   ;	       /* apply rotation to x,y,z axis */
   ;	       rotate_x(model, cosine, sine);
   ;	
	FLD	qword ptr [bp-22]
	add	sp,65528
	FSTP	qword ptr [bp-50]
	FLD	qword ptr [bp-14]
	add	sp,65528
	FSTP	qword ptr [bp-58]
	push	si
	FWAIT	
	call	near ptr _rotate_x
	add	sp,18
   ;	
   ;	       rotate_y(model, cosine, sine);
   ;	
	FLD	qword ptr [bp-22]
	add	sp,65528
	FSTP	qword ptr [bp-50]
	FLD	qword ptr [bp-14]
	add	sp,65528
	FSTP	qword ptr [bp-58]
	push	si
	FWAIT	
	call	near ptr _rotate_y
	add	sp,18
   ;	
   ;	       rotate_z(model, ncosine, nsine);
   ;	
	FLD	qword ptr [bp-38]
	add	sp,65528
	FSTP	qword ptr [bp-50]
	FLD	qword ptr [bp-30]
	add	sp,65528
	FSTP	qword ptr [bp-58]
	push	si
	FWAIT	
	call	near ptr _rotate_z
	add	sp,18
   ;	
   ;	
   ;	       /* finally, redraw model */
   ;	       draw_model(model, 280, 110);
   ;	
	mov	ax,110
	push	ax
	mov	ax,280
	push	ax
	push	si
	call	near ptr _draw_model
	add	sp,6
   ;	
   ;	
   ;	       /* page flip */
   ;	       setvisualpage(page = !page);
   ;	
	mov	ax,di
	neg	ax
	sbb	ax,ax
	inc	ax
	mov	di,ax
	push	ax
	call	far ptr _setvisualpage
	pop	cx
   ;	
   ;	
   ;	       delay(30);
   ;	
	mov	ax,30
	push	ax
	call	near ptr _delay
	pop	cx
   ;	
   ;	    } while (!kbhit());
   ;	
	call	near ptr _kbhit
	or	ax,ax
	jne	@@3
	jmp	@6@98
@@3:
   ;	
   ;	
   ;	    getch();	/* flush keyboard buffer */
   ;	
	call	near ptr _getch
   ;	
   ;	
   ;	    closegraph();
   ;	
	call	far ptr _closegraph
   ;	
   ;	    return 0;
   ;	
	xor	ax,ax
	jmp	short @6@170
@6@170:
   ;	
   ;	}
   ;	
	pop	di
	pop	si
	mov	sp,bp
	pop	bp
	ret	
_main	endp
	?debug	C E9
_TEXT	ends
_DATA	segment word public 'DATA'
s@	label	byte
	db	0
	db	0
	db	'zD'
	db	0
	db	0
	db	'`AC:\TOOLS\BCC31\BGI'
	db	0
	db	'Graphics error: %s'
	db	10
	db	0
	db	0
	db	0
	db	0
	db	'@'
	db	-102
	db	-103
	db	-103
	db	-103
	db	-103
	db	-103
	db	-71
	db	'?'
	db	-102
	db	-103
	db	-103
	db	-103
	db	-103
	db	-103
	db	-71
	db	-65
_DATA	ends
_TEXT	segment byte public 'CODE'
_TEXT	ends
	extrn	_setvisualpage:far
	extrn	_setactivepage:far
	public	_compute_illumination
	extrn	_setfillstyle:far
	extrn	_cos:near
	extrn	_printf:near
	public	_light_src
	extrn	_kbhit:near
	extrn	_setcolor:far
	extrn	_getmaxy:far
	extrn	_getmaxx:far
	extrn	_fillpoly:far
	extrn	_closegraph:far
	extrn	_sqrt:near
	public	_wedge
	public	_init_light_source
	extrn	_getch:near
	public	_main
	extrn	_delay:near
	extrn	_sin:near
	public	_cube
	public	_is_visible
	extrn	_grapherrormsg:far
	extrn	_bar:far
	extrn	_exit:near
	extrn	_graphresult:far
	extrn	N_FTOL@:far
	extrn	_rotate_z:near
	extrn	_rotate_y:near
	extrn	_rotate_x:near
	extrn	_setrgbpalette:far
	public	_apply_perspective
	extrn	_initgraph:far
	extrn	_scale:near
	public	_draw_model
	end
